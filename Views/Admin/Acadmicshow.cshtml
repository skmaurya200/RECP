@{
    ViewBag.Title = "Academic Calendar";
    Layout = "~/Views/Shared/admin.cshtml";
}

@model List<Rec_Partapgarh.Models.AcademicCalendar>
<div class="p-3">
    <h2 class="fw-bold  mt-4" style="color: #450145;">Academic Calendar</h2>
    <hr style="border:1px solid black;" />
    <a href="@Url.Action("adcadmicCreate")" class="btn btn-success btn-sm mb-3">
        <i class="fas fa-plus"></i> Add New
    </a>

    <div class="table-responsive">
        <table class="table table-bordered table-hover shadow-sm">
            <thead class="text-center text-white" style="background-color: #4a004a;">
                <tr class="text-center">
                    <th style="width: 5%; background-color: #450145; color: white;">S.NO.</th>
                    <th style="width: 30%;  background-color: #450145; color:white;">Title</th>
                    <th style="width: 20%;  background-color: #450145; color:white;">Semester Type</th>
                    <th style="width: 25%;  background-color: #450145; color:white;">Download File</th>
                    <th style="width: 20%;  background-color: #450145; color:white;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int count = 1;
                    foreach (var item in Model)
                    {
                        <tr class="text-center">
                            <td>@count</td>
                            <td class="">@item.Title</td>
                            <td>@item.SemesterType</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.FilePath))
                                {
                                    <a href="@item.FilePath" class="text-primary fw-bold" target="_blank">
                                        <i class="fas fa-download"></i> Download
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Not Available</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("acadmicEdit", "admin", new { id = item.Id })" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a href="@Url.Action("adcdmicDelete", "admin", new { id = item.Id })" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </a>
                            </td>
                        </tr>
                        count++;
                    }
                }
                else
                {
                    <tr class="text-center">
                        <td colspan="5" class="text-muted fw-bold">No Records Found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

