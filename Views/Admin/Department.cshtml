@{
    ViewBag.Title = "Add Department";
    Layout = "~/Views/Shared/Admin.cshtml";
}
<div class="row p-3 pt-4 border border m-3">

    <h2 style="color: #450145;" class="fw-bold">Add New Department</h2>
    <hr />
    @if (!string.IsNullOrEmpty(ViewBag.Msg))
    {
        <div class="alert alert-info">@ViewBag.Msg</div>
    }

    <form action="@Url.Action("AddDepartment", "Admin")" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Department Name</label>
            <input type="text" name="DepartmentName" class="form-control rounded-0" required />
        </div>

        <div class="form-group mt-3 mt-3">
            <label>Content</label>
            <textarea name="Content" class="form-control rounded-0" required></textarea>
        </div>

        <div class="form-group mt-3">
            <label>Upload Image</label>
            <input type="file" name="file" class="form-control" required />
        </div>
        <div class="mt-3">
            <button type="submit" class="btn text-light rounded-0" style="background-color: #450145;">Add Department </button>
            <a href="@Url.Action("Department", "Department")" class="btn btn-secondary rounded-0">Back</a>
        </div>
       
    </form>

</div>