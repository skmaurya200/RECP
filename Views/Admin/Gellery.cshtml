@model Rec_Partapgarh.Models.Gallery

@{
    ViewBag.Title = "Gellery";
    Layout = "~/Views/Shared/Admin.cshtml";
}

@using (Html.BeginForm("Addgellery", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal border  mt-3" style="width:95%; height:auto; margin:0px auto; padding:30px;">
        <h4 class="fw-bold" style="color: #450145;"> Add Gallery</h4>
        <hr />
        @if (ViewBag.msg != null)
        {

            <div class="alert alert-primary" style=" border-radius:0px; color:green;" role="alert">
                @ViewBag.msg
            </div>
        }
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.Text, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="row">
                <div class="col-md-6">
                    @Html.EditorFor(model => model.Text, new { htmlAttributes = new { @class = "form-control mt-3", @placeholder = "Enter Text ", required = "required", style = "height:50px; border-radius:0px;" } })
                    @Html.ValidationMessageFor(model => model.Text, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mt-3">

                    <input list="categories" id="fruitInput" name="categories" class="form-control" style="height:50px; border-radius:0px;" , placeholder="Enter Categories" required>
                    @foreach (var item in ViewBag.Cat)
                    {
                        <datalist id="categories" class="">

                            <option value="@item.categories">

                        </datalist>
                    }
                </div>
            </div>
        </div>

        <div class="form-group mt-3">
            @Html.LabelFor(model => model.Image, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-12 border p-3 mt-3">
                <input type="file" name="file" />
            </div>
        </div>





        <div class="form-group mt-3">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit"  class="btn" style="background-color: #450145; height: 50px; width: 150px; border-radius: 0px; color: white;" />
            </div>
        </div>
    </div>


}
