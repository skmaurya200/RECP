﻿
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/admin.cshtml";
}

<div class="page-wrapper mdc-toolbar-fixed-adjust">
    <main class="content-wrapper">
        <div class="mdc-layout-grid">
            <div class="mdc-layout-grid__inner">
                <div class="mdc-layout-grid__cell stretch-card mdc-layout-grid__cell--span-3-desktop mdc-layout-grid__cell--span-4-tablet">
                    <div class="mdc-card info-card info-card--success">
                        <div class="card-inner">
                            <h5 class="card-title">Show Enquiry</h5>
                            <h5 class="font-weight-light pb-2 mb-1 border-bottom fw-bold">@ViewBag.EnquiryCount</h5>
                            <p class="tx-12 text-muted">Number of Enquiry</p>
                            <div class="card-icon-wrapper">
                                <i class="material-icons">dvr</i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mdc-layout-grid__cell stretch-card mdc-layout-grid__cell--span-3-desktop mdc-layout-grid__cell--span-4-tablet">
                    <div class="mdc-card info-card info-card--danger">
                        <div class="card-inner">
                            <h5 class="card-title">Total Faculty</h5>
                            <h5 class="font-weight-light pb-2 mb-1 border-bottom fw-bold">@ViewBag.FacultyCount</h5>
                            <p class="tx-12 text-muted">Number Of Faculty</p>
                            <div class="card-icon-wrapper">
                                <i class="fa-solid fa-users"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mdc-layout-grid__cell stretch-card mdc-layout-grid__cell--span-3-desktop mdc-layout-grid__cell--span-4-tablet">
                    <div class="mdc-card info-card info-card--primary">
                        <div class="card-inner">
                            <h5 class="card-title">Total Notification</h5>
                            <h5 class="font-weight-light pb-2 mb-1 border-bottom fw-bold">@ViewBag.NotificationCount</h5>
                            <p class="tx-12 text-muted">Number of Notification</p>
                            <div class="card-icon-wrapper">
                                <i class="fa-solid fa-bell"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mdc-layout-grid__cell stretch-card mdc-layout-grid__cell--span-3-desktop mdc-layout-grid__cell--span-4-tablet">
                    <div class="mdc-card info-card info-card--info">
                        <div class="card-inner">
                            <h5 class="card-title">Total Department</h5>
                            <h5 class="font-weight-light pb-2 mb-1 border-bottom fw-bold">@ViewBag.DepartmentCount</h5>
                            <p class="tx-12 text-muted">Number of Department</p>
                            <div class="card-icon-wrapper">
                                <i class="material-icons">credit_card</i>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>
   
    </div>
