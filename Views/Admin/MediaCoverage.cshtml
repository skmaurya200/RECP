@model Rec_Partapgarh.Models.MediaCoverage

@{
    ViewBag.Title = "Media Coverage";
    Layout = "~/Views/Shared/Admin.cshtml";

    var mediaList = ViewBag.MediaCoverageList as List<Rec_Partapgarh.Models.MediaCoverage>;
    int sr = 1;
}

<style>
    .mc-wrapper {
        width: 95%;
        margin: 20px auto;
        padding: 25px;
        border: 1px solid #ddd;
        background: #fff;
    }

    .mc-title {
        color: #450145;
        font-weight: 700;
        margin: 0;
    }

    .mc-btn-main {
        background-color: #450145;
        color: #fff;
        border-radius: 0;
        min-width: 130px;
        height: 42px;
        border: none;
    }

        .mc-btn-main:hover {
            background-color: #2d012d;
            color: #fff;
        }

    .mc-btn-edit {
        background-color: #0d6efd;
        color: #fff;
        border-radius: 0;
        padding: 6px 14px;
        border: none;
    }

    .mc-btn-delete {
        background-color: #dc3545;
        color: #fff;
        border-radius: 0;
        padding: 6px 14px;
        border: none;
    }

    .mc-form-control {
        height: 48px;
        border-radius: 0;
        box-shadow: none;
    }

    .mc-textarea {
        min-height: 100px;
        border-radius: 0;
        box-shadow: none;
    }

    .mc-img {
        height: 70px;
        width: 100px;
        object-fit: cover;
        border: 1px solid #ddd;
    }

    .mc-modal-content {
        border-radius: 0;
    }

    .mc-modal-header {
        background-color: #450145;
        color: #fff;
        border-radius: 0;
    }

    .mc-table th {
        background-color: #450145;
        color: #fff;
        white-space: nowrap;
    }

    .mc-table td {
        vertical-align: middle;
    }

    .close {
        color: #fff;
        opacity: 1;
        border: none;
        background: transparent;
        font-size: 28px;
        line-height: 1;
    }

    .description-box {
        max-width: 320px;
        white-space: normal;
    }

    @@media(max-width: 576px) {
        .mc-wrapper {
            width: 98%;
            padding: 15px;
        }

        .mc-title {
            font-size: 20px;
        }

        .mc-btn-main {
            width: 100%;
            margin-top: 12px;
        }

        .mc-img {
            width: 80px;
            height: 60px;
        }
    }
</style>

<div class="mc-wrapper">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        <h4 class="mc-title">Media Coverage</h4>

        <button type="button"
                class="btn mc-btn-main"
                data-bs-toggle="modal"
                data-bs-target="#addMediaModal"
                data-toggle="modal"
                data-target="#addMediaModal">
            Add Media
        </button>
    </div>

    <hr />

    @if (ViewBag.Msg != null)
    {
        <div class="alert alert-primary" style="border-radius:0; color:green;">
            @ViewBag.Msg
        </div>
    }

    <div class="table-responsive mt-3">
        <table class="table table-bordered table-striped mc-table" id="mediaCoverageTable">
            <thead>
                <tr>
                    <th>Sr.No.</th>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Date</th>
                    <th style="width:180px;">Action</th>
                </tr>
            </thead>

            <tbody>
                @if (mediaList != null && mediaList.Count > 0)
                {
                    foreach (var item in mediaList)
                    {
                        <tr>
                            <td>@sr</td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@Url.Content("~/Content/upload/MediaCoverage/" + item.ImagePath)"
                                         class="mc-img"
                                         alt="@item.Title" />
                                }
                            </td>

                            <td>@item.Title</td>

                            <td class="description-box">
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    @item.Description
                                }
                                else
                                {
                                    <span class="text-muted">No Description</span>
                                }
                            </td>

                            <td>@item.Dos.ToString("dd-MM-yyyy")</td>

                            <td>
                                <button type="button"
                                        class="btn mc-btn-edit btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editMediaModal_@item.Id"
                                        data-toggle="modal"
                                        data-target="#editMediaModal_@item.Id">
                                    Edit
                                </button>

                                <button type="button"
                                        class="btn mc-btn-delete btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteMediaModal_@item.Id"
                                        data-toggle="modal"
                                        data-target="#deleteMediaModal_@item.Id">
                                    Delete
                                </button>
                            </td>
                        </tr>

                        sr++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            No Media Coverage Found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ADD MODAL START -->
<div class="modal fade" id="addMediaModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content mc-modal-content">

            @using (Html.BeginForm("AddMediaCoverage", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="modal-header mc-modal-header">
                    <h5 class="modal-title">Add Media Coverage</h5>

                    <button type="button"
                            class="close"
                            data-bs-dismiss="modal"
                            data-dismiss="modal"
                            aria-label="Close">
                        <span>&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label>Title <span class="text-danger">*</span></label>
                        <input type="text"
                               name="Title"
                               class="form-control mc-form-control"
                               placeholder="Enter Title"
                               required />
                    </div>

                    <div class="form-group mb-3">
                        <label>Description <small class="text-muted">(Optional)</small></label>
                        <textarea name="Description"
                                  class="form-control mc-textarea"
                                  placeholder="Enter Description"></textarea>
                    </div>

                    <div class="form-group mb-3">
                        <label>Upload Image <span class="text-danger">*</span></label>
                        <input type="file"
                               name="file"
                               class="form-control mc-form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               required />
                        <small class="text-muted">Allowed: JPG, JPEG, PNG, WEBP | Max size: 5MB</small>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            style="border-radius:0;"
                            data-bs-dismiss="modal"
                            data-dismiss="modal">
                        Close
                    </button>

                    <button type="submit" class="btn mc-btn-main">
                        Save
                    </button>
                </div>
            }

        </div>
    </div>
</div>
<!-- ADD MODAL END -->

@if (mediaList != null && mediaList.Count > 0)
{
    foreach (var item in mediaList)
    {
        <!-- EDIT MODAL START -->
        <div class="modal fade" id="editMediaModal_@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
                <div class="modal-content mc-modal-content">

                    @using (Html.BeginForm("UpdateMediaCoverage", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="Id" value="@item.Id" />

                        <div class="modal-header mc-modal-header">
                            <h5 class="modal-title">Edit Media Coverage</h5>

                            <button type="button"
                                    class="close"
                                    data-bs-dismiss="modal"
                                    data-dismiss="modal"
                                    aria-label="Close">
                                <span>&times;</span>
                            </button>
                        </div>

                        <div class="modal-body">
                            <div class="form-group mb-3">
                                <label>Title <span class="text-danger">*</span></label>
                                <input type="text"
                                       name="Title"
                                       value="@item.Title"
                                       class="form-control mc-form-control"
                                       placeholder="Enter Title"
                                       required />
                            </div>

                            <div class="form-group mb-3">
                                <label>Description <small class="text-muted">(Optional)</small></label>
                                <textarea name="Description"
                                          class="form-control mc-textarea"
                                          placeholder="Enter Description">@item.Description</textarea>
                            </div>

                            <div class="form-group mb-3">
                                <label>Current Image</label>
                                <br />

                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@Url.Content("~/Content/upload/MediaCoverage/" + item.ImagePath)"
                                         class="mc-img"
                                         alt="@item.Title" />
                                }
                            </div>

                            <div class="form-group mb-3">
                                <label>Change Image <small class="text-muted">(Optional)</small></label>
                                <input type="file"
                                       name="file"
                                       class="form-control mc-form-control"
                                       accept=".jpg,.jpeg,.png,.webp" />
                                <small class="text-muted">Leave empty if you do not want to change image.</small>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-secondary"
                                    style="border-radius:0;"
                                    data-bs-dismiss="modal"
                                    data-dismiss="modal">
                                Close
                            </button>

                            <button type="submit" class="btn mc-btn-main">
                                Update
                            </button>
                        </div>
                    }

                </div>
            </div>
        </div>
        <!-- EDIT MODAL END -->

        <!-- DELETE MODAL START -->
        <div class="modal fade" id="deleteMediaModal_@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content mc-modal-content">
                    <div class="modal-header mc-modal-header">
                        <h5 class="modal-title">Delete Media Coverage</h5>

                        <button type="button"
                                class="close"
                                data-bs-dismiss="modal"
                                data-dismiss="modal"
                                aria-label="Close">
                            <span>&times;</span>
                        </button>
                    </div>

                    <div class="modal-body">
                        <p>Are you sure you want to delete this media coverage?</p>
                        <strong>@item.Title</strong>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                style="border-radius:0;"
                                data-bs-dismiss="modal"
                                data-dismiss="modal">
                            Cancel
                        </button>

                        <a href="@Url.Action("DeleteMediaCoverage", "Admin", new { id = item.Id })"
                           class="btn mc-btn-delete">
                            Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <!-- DELETE MODAL END -->
    }
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>