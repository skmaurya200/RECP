@{
    ViewBag.Title = "Manage Slider";
    Layout = "~/Views/Shared/admin.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 p-4">
        <h2 class="text-center text-primary mb-4 fw-bold">Manage Slider</h2>

        @if (ViewBag.Msg != null)
        {
            <script>
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: '@ViewBag.Msg',
                    timer: 2000,
                    showConfirmButton: false
                });
            </script>
        }

        <form action="@Url.Action("UploadSilder", "Admin")" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-bold">Upload Slider Image</label>
                <input type="file" name="file" class="form-control form-control-lg rounded-3 shadow-sm" required />
                <div class="invalid-feedback">
                    Please select an image to upload.
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill shadow-sm">Upload Image</button>
        </form>
    </div>

    <hr class="my-5" />

    <div class="card shadow-lg border-0 p-4">
        <h3 class="text-center text-success mb-3 fw-bold">Slider Images</h3>
        <table class="table table-striped text-center align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.SilderImg != null && ViewBag.SilderImg.Count > 0)
                {
                    foreach (var item in ViewBag.SilderImg)
                    {
                        <tr>
                            <td>
                                <img src="~/Content/recp/Upload/SilderImages/@item.Image" class="img-thumbnail rounded shadow-sm" width="120" height="60" />
                            </td>
                            <td>@item.Dos</td>
                            <td>
                                <a href="@Url.Action("DeleteSilder", "Admin", new { id = item.Id })"
                                   class="btn btn-danger btn-sm rounded-pill px-3"
                                   onclick="return confirm('Are you sure you want to delete this image?');">
                                    <i class="fas fa-trash-alt me-1"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-muted">No images uploaded yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')

        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault()
                    event.stopPropagation()
                }
                form.classList.add('was-validated')
            }, false)
        })
    })()
</script>
