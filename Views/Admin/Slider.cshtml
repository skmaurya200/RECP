@{
    ViewBag.Title = "Manage Slider";
    Layout = "~/Views/Shared/admin.cshtml";
}

<!-- ✅ SweetAlert Messages -->
@if (ViewBag.Msg != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @ViewBag.Msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="card border rounded-0 p-3 mt-3 shadow-sm">
    <h4 style="color: #450145;" class="fw-bold">Upload New Slider</h4>
    <hr />
    <form action="@Url.Action("UploadSlider", "Admin")" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label fw-semibold">Slider Heading:</label>
            <input type="text" name="Heading" class="form-control" placeholder="Enter slider title..." required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Slider Paragraph:</label>
            <textarea name="Paragraph" class="form-control" rows="2" placeholder="Enter slider description..." required></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Select Image:</label>
            <input type="file" name="file" class="form-control" accept=".jpg, .jpeg, .png" required />
        </div>

        <button type="submit" class="btn px-4" style="background-color: #450145; color: white;">
            <i class="bi bi-upload me-1"></i> Upload
        </button>
    </form>
</div>

<h4 class="mt-4 fw-bold text-muted mb-3">Uploaded Sliders</h4>

@if (ViewBag.SliderImages != null && ViewBag.SliderImages.Count > 0)
{
    <div class="table-responsive shadow-sm">
        <table id="sliderTable" class="table table-bordered text-center align-middle">
            <thead class="table-light">
                <tr>
                    <th style="background-color:#0747ae; color:white;">S.NO</th>
                    <th style="background-color:#0747ae; color:white;">Image</th>
                    <th style="background-color:#0747ae; color:white;">Heading</th>
                    <th style="background-color:#0747ae; color:white;">Paragraph</th>
                    <th style="background-color:#0747ae; color:white;">Action</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var a = 1;
                }
                @foreach (var slider in ViewBag.SliderImages)
                {
                    <tr>
                        <td>@a</td>
                        <td>
                            <img src="~/Content/Upload/SilderImages/@slider.Image"
                                 class="img-thumbnail shadow-sm"
                                 width="100" height="100" />
                        </td>
                        <td>@slider.Heading</td>
                        <td>@slider.Paragraph</td>
                        <td>
                            <a href="@Url.Action("DeleteSlider", "Admin", new { id = slider.Id })"
                               class="btn btn-danger btn-sm delete-slider">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                    a++;
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-center mt-3 text-muted">No sliders uploaded yet.</p>
}

<!-- ✅ Required Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        $('#sliderTable').DataTable({
            paging: true,
            searching: true,
            info: true
        });

        $(".delete-slider").click(function (event) {
            event.preventDefault();
            var url = $(this).attr("href");

            Swal.fire({
                title: "Are you sure?",
                text: "Once deleted, this slider cannot be recovered!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        });
    });
</script>
