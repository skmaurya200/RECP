@{
    ViewBag.Title = "Upload Gallery";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header  text-white" style="background-color: #450145;">
            <h4 class="mb-0">Upload Gallery</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("UploadGallery", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Enter Category:</label>
                    <input type="text" name="CategoryName" class="form-control" placeholder="Enter category name" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Choose Image:</label>
                    <input type="file" name="ImageFile" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-cloud-upload-fill"></i> Upload
                </button>
            }

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success mt-3">@ViewBag.Message</div>
            }
        </div>
    </div>

    <!-- Gallery Table -->
    @if (ViewBag.Gallery != null && ViewBag.Gallery.Count > 0)
    {
        <div class="card shadow-lg border-0 rounded-3 mt-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Uploaded Gallery</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 10%; background-color: #450145;">#</th>
                            <th style="width:30%;">Category</th>
                            <th style="width:40%;">Image</th>
                            <th style="width:20%;">Uploaded Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                            foreach (var item in ViewBag.Gallery)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>@item.CategoryName</td>
                                    <td>
                                        <img src="@Url.Content("~/Content/upload/Gallery/" + item.ImageFile)"
                                             alt="gallery-img" class="img-thumbnail shadow-sm" style="height:80px;" />
                                    </td>
                                    <td>@item.UploadDate.ToString("dd-MMM-yyyy")</td>
                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-4 text-center">
            No images uploaded yet.
        </div>
    }
</div>
