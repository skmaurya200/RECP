
@{
    ViewBag.Title = "acadmicEdit";
    Layout = "~/Views/Shared/admin.cshtml";
}

@model REC_MIRZAPUR.Models.AcademicCalendar

<h2>Edit Academic Calendar</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@using (Html.BeginForm("acadmicEdit", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(m => m.Id)

    <div class="form-group">
        <label>Title:</label>
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", required = "required" })
    </div>

    <div class="form-group">
        <label>Select Semester:</label>
        @Html.DropDownListFor(m => m.SemesterType, new List<SelectListItem>
        {
            new SelectListItem { Text = "Even Semester", Value = "Even" },
            new SelectListItem { Text = "Odd Semester", Value = "Odd" }
        }, "-- Select Semester --", new { @class = "form-control", required = "required" })
    </div>

    <div class="form-group">
        <label>Current File:</label>
        @if (!string.IsNullOrEmpty(Model.FilePath))
        {
            <p><a href="@Url.Content(Model.FilePath)" target="_blank" class="text-warning">View Current File</a></p>
        }
    </div>

    <div class="form-group">
        <label>Upload New File (Optional):</label>
        <input type="file" name="File" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Update</button>
}
