@model IEnumerable<Rec_Partapgarh.Models.GalleryImage>

@{
    Layout = "~/Views/Shared/admin.cshtml";
    ViewBag.Title = "Upload Gallery";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header text-white" style="background-color: #450145;">
            <h4 class="mb-0">Upload Gallery</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("UploadGallery", "Gallery", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Enter Category:</label>
                    <input type="text" name="CategoryName" class="form-control" placeholder="Enter category name" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Choose Image:</label>
                    <input type="file" name="ImageFile" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-cloud-upload-fill"></i> Upload
                </button>
            }

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success mt-3">@ViewBag.Message</div>
            }
        </div>
    </div>

    <hr />
    <style>
        td,th {
            word-wrap: break-word !important;
            white-space: normal !important;
            text-align: left !important;
           
        }
            td .no-wrap {
                white-space: nowrap !important;
            }

    </style>


    <h4 class="mt-4">Gallery Images</h4>
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="text-white" style="background-color:#450145;">
                <tr style="text-align:left !important;">
                    <th scope="col">Image</th>
                    <th scope="col">Category</th>
                    <th scope="col" style="width:150px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@Url.Content(item.ImagePath)" width="100" height="80" class="img-thumbnail" />
                        </td>
                        <td>@item.Category.Name</td>
                        <td class="no-wrap">
                            <a href="@Url.Action("Edit", "Gallery", new { id = item.Id })" class="btn btn-warning btn-sm me-1">Edit</a>
                            <a href="@Url.Action("Delete", "Gallery", new { id = item.Id })" class="btn btn-danger btn-sm"
                               onclick="return confirm('Are you sure to delete this image?');">Delete</a>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
