@{
    
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Department of Applied Sciences & Humanities (APSH)
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Department of Applied Sciences & Humanities (APSH)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_ASH_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Department of Applied Sciences & Humanities (APSH)</h2>
                <hr />

                <p class="welfare-font mt-3 text-justify text-dark" style="font-size:17px; line-height:34px;">
                    The department of Applied Sciences & Humanities (APSH) at Bharat Ratna Babasaheb Bhimrao Ambedkar Rajkiya Engineering College Pratapgarh provides the academic foundation for all engineering programmes. The department offers interdisciplinary teaching in core areas such as Mathematics, Physics, Chemistry, Management, Professional Communication, Human Values, and Professional Ethics. In addition, the department offers courses on Indian Knowledge Systems, encompassing Indian culture and traditions, the Indian Constitution, ecology, and environmental sciences, as prescribed by Dr A PJ Abdul Kalam Technical University Uttar Pradesh Lucknow.
                </p>

                <p class="welfare-font  text-justify text-dark" style="font-size:17px; line-height:34px;">
                    The department emphasizes outcome-based and experiential learning through qualified faculty members, well-equipped laboratories, and activity-oriented teaching practices. These approaches enhance conceptual clarity and practical understanding among students. The department prepares students for engineering careers, higher studies, research, and entrepreneurship.
                </p>

                <p class="welfare-font mt-3 text-justify text-dark" style="font-size:17px; line-height:34px;">
                    In alignment with NEP-2020, the department integrates emerging academic trends such as nanomaterials, applied sciences, sustainability, soft-skill development, and entrepreneurial competencies. This holistic approach fosters ethically responsible and professionally competent engineers.
                </p>

            </div>
        </div>
    </div>
</div>



















