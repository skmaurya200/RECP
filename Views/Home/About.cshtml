<div class="our-featues-area inc-trending-courses about-area mt-0" data-aos="fade-up" style="background-image: url(assets/img/bg1.jpg); padding-top: 40px !important;margin-bottom:50px;">

    <style>
        .about-section {
            padding: 30px 0;
        }

        .about-image {
            width: 100%;
            height: 38rem;
            border-radius: 10px;
            box-shadow: 3px 5px 10px rgba(130, 130, 130, 0.5);
        }

        .about-heading {
            font-size: 24px;
            font-weight: 700;
            color: #0747ae;
            border-bottom: 2px solid #D3d3d3;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

