        <div class="col-md-2 text-center" style="background-color: #0747ae;">
            <p class="text-white fw-bold m-0 p-3">Accreditations</p>
        </div>
        <div class="col-md-10">
            <marquee onmouseover="stop()" onmouseout="start()">

            </marquee>
        </div>
    </div>
</div>
