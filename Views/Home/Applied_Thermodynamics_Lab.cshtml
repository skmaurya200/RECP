@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Applied Thermodynamics Laboratory
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Applied Thermodynamics Laboratory</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_MCHE_Sidebar.cshtml")

        <style>
                    table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 16px;
                        margin-top: 20px;
                    }

                        table th {
                            background-color: #0747AE;
                            color: #fff;
                            font-weight: bold;
                            padding: 10px;
                            border: 1px solid #0747AE;
                        }

                        table td {
                            border: 1px solid #ddd;
                            padding: 10px;
                            text-align: center;
                            background-color: #fafafa;
                        }

                        table tr:hover td {
                            background-color: #f1f5ff;
                        }
        </style>

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Applied Thermodynamics Laboratory</h2>
                <hr />
                <p class="welfare-font"> The applied thermodynamics laboratory enables students to understand the working principles, performance characteristics, and real-world applications of thermal systems used in power generation and internal combustion processes. The lab provides hands-on exposure to boilers, IC engines, steam engines, and turbines, helping students connect theoretical concepts with practical operation. This lab is equipped with the following major testing facilities:</p>
                <ul class="welfare-font" style="list-style-type:disc !important; margin-left:20px; margin-top:-10px;">
                    <li>Boilers (3D Model): Study of construction, working principles, classification, mountings and accessories, steam generation, and basic efficiency for power plant applications.</li>
                    <li>Internal Combustion Engines: Understanding types of IC engines, operating cycles, and fuel systems, along with experiments to determine brake power, efficiency, and specific fuel consumption for performance evaluation.</li>
                </ul>

                <p class="welfare-font"> The applied thermodynamics laboratory strengthens students’ understanding of thermal energy conversion, power cycles, and engine behaviour, forming a crucial foundation for advanced courses in thermal engineering, power plant engineering, and energy systems.</p>


<div class="div1" style="display:flex; width:100%;">
<div class="div2"> <img src="~/Content/DEPIMG/Applied Thermodynamics Laboratory1.jpg" style="border:1px dashed black; padding:5px; height:270px; width:600px !important;"/></div>
<div class="div2"> <img src="~/Content/DEPIMG/Applied Thermodynamics Laboratory2.jpg" style="border:1px dashed black; padding:5px; height:270px; width:600px !important;"/></div>
<div class="div2"> <img src="~/Content/DEPIMG/Applied Thermodynamics Laboratory3.png" style="border:1px dashed black; padding:5px; height:270px; width:600px !important; "/></div>
</div>
            </div>
        </div>
    </div>
</div>



























