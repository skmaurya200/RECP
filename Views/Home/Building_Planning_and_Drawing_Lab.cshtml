@{
    
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Building Planning and Drawing Lab
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Building Planning and Drawing Lab</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_CVLE_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Building Planning and Drawing Lab</h2>
                <hr />
               <div class="row mt-2">
                    <div class="col-lg-5">
                        <img src="~/Content/img/Building_Planning_and_Drawing_Lab.jpg" class="p-1" style="height:300px;width:100%;border:1px dashed #000;object-fit:cover" />
                    </div>
                    <div class="col-lg-7">
                        <p class="welfare-font">
                            The Building Planning and Drawing Lab helps students learn how to design and plan buildings practically and effectively. In this lab, students work on drawings, layouts, and models to understand how buildings should be arranged for good use, safety, and comfort. It also teaches how to use space effectively and choose suitable building materials. The lab supports the development of skills needed for planning strong, efficient, and well-designed structures. The lab is equipped with 20 dedicated, state-of-the-art computers equipped with specialised software, enabling students to work on modern building design and drafting tools.
                        </p>
                    </div>
                    
                </div>
                <p class="welfare-font" style="font-weight:700;">List of Experiments</p>
                <ul class="welfare-font" style="list-style-type:disc !important;">
                    <li>Introduction to the tools and commands of drafting software.</li>
                    <li>Working in layers, blocks, x-ref, drawing layout and print setup.</li>
                    <li>3D drafting and rendering.</li>
                    <li>Planning and drafting of the elevation and cross-section of door and window</li>
                    <li>Planning and drafting of the plan and cross-section of the Dog-legged and open well staircase.</li>
                    <li>Planning, drawing and modeling of a residential building of 1 room set.</li>
                    <li>Planning, drawing and modeling of 3 3-room residential building with staircase.</li>
                </ul>
            </div>
            
        </div>
    </div>
</div>
































