@{
    
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        CAD Lab
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>CAD Lab</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_CVLE_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">CAD Lab</h2>
                <hr />
                <div class="row mt-2">
                    <div class="col-lg-5">
                        <img src="~/Content/img/CAD_Lab.jpg" class="p-1" style="height:330px;width:100%;border:1px dashed #000;object-fit:cover" />
                    </div>
                    <div class="col-lg-7">
                        <p class="welfare-font">
                            The Computer-Aided Design (CAD) Laboratory is a vital part of the Civil Engineering Department, designed to equip students with essential skills in digital drafting, modelling, and design. This state-of-the-art facility provides a platform for students to transition from traditional manual drafting methods to modern, software-based techniques widely used in the construction and design industries. The lab features 20 dedicated, state-of-the-art computers equipped with specialised CAD software, allowing students to create precise digital building designs, layouts, and models efficiently. By integrating theoretical knowledge with practical applications, the CAD Lab plays a key role in shaping industry-ready civil engineering professionals.
                        </p>
                    </div>

                </div>

                <p class="welfare-font fw-bold">List of Experiments</p>
                <ul class="welfare-font" style="list-style-type:disc !important;">
                    <li>Students will be able to work on Geo 5 /PLAXIS/STAAD Pro /Etabs software.</li>
                    <li>Students will be able to work on QGIS software.</li>
                    <li>Students will be able to design and analyze cantilever, gravity wall, retaining wall using geotechnical engineering software/design and analysis of multistory building using structural analysis and design software.</li>
                    <li>Students will be able to geo reference a given map using QGIS softwares.</li>
                    <li>Students will be able to prepare maps using QGIS.</li>
                </ul>


            </div>
           
        </div>
    </div>
</div>
































