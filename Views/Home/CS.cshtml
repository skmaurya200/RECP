@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Department of Computer Science and Engineering
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Department of Computer Science and Engineering</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_CS_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">About</h2>
                <hr />

                <p class="welfare-font" style="margin-top:10px;">
                    The department of Computer Science and Engineering at Bharat Ratna Babasaheb Bhimrao Ambedkar Rajkiya Engineering College Pratapgarh aims to impart high-quality technical education in the field of computing and information technologies. Established with this objective, the department plays a pivotal role in addressing the growing demand for skilled computer engineers across industry, research, and enterpreneurs.
                </p>

                <p class="welfare-font">
                    The department of Computer Science and Engineering offers a Bachelor of Technology (B.Tech.) program with an approved intake of 60 students. The department follows an industry-aligned curriculum covering core areas such as Data Structures, Algorithms, Computer Organization, Database Management Systems, Operating Systems, Computer Networks, Artificial Intelligence, Machine Learning, and Cybersecurity. The program integrates strong theoretical foundations with hands-on practical training, enabling students to design efficient, scalable, and intelligent computing solutions.
                </p>

                <p class="welfare-font">
                    Aligned with AICTE guidelines and NEP-2020 reforms, the department emphasizes outcome-based education and multidisciplinary learning. It continuously adapts to emerging technologies and modern pedagogical practices to ensure holistic student development. The department develops competent engineers, innovative thinkers, and socially responsible professionals for industry, academia, and sustainable technological advancement.
                </p>
            </div>
        </div>
    </div>
</div>




















































