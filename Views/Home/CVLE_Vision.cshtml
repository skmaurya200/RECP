@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Vision & Mission
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Vision & Mission</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_CVLE_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Vision</h2>
                <hr />
                <p class="welfare-font" style="margin-top:10px;">
                    To emerge as a distinguished centre of civil engineering education and research, nurturing engineers who lead the development of sustainable, resilient, and technologically advanced infrastructure. The department strives to make meaningful contributions to national growth and global progress through innovation, community engagement, and a continual pursuit of excellence.
                </p>
            </div>
			<div class="content-box mt-2">

                <h2 class="fw-bold" style="color:#0747AE;">Mission</h2>
                <hr />
                <ul style="list-style-type:disc !important; margin-top:10px;" class="welfare-font">
                    <li>To impart comprehensive civil engineering education that blends strong theoretical foundations with practical exposure, modern tools, and industry-relevant skills.</li>
                    <li>To promote a culture of research, innovation, and interdisciplinary learning that addresses emerging challenges in infrastructure development, environmental protection, and societal needs.</li>
                    <li>To strengthen partnerships with industry, academia, and government agencies for collaborative learning, hands-on training, and knowledge exchange.</li>
                    <li>To develop ethically responsible, environmentally conscious, and socially committed civil engineers capable of contributing to sustainable development and professional excellence.</li>
                </ul>
            </div>
        </div>
    </div>
</div>




































