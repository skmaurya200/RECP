@{
   
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

    .bg-welfare-left h3 {
        font-size: 21px;
        font-weight: 600;
        color: #fff;
    }

    .bg-welfare-left ul li {
        margin-top: 18px;
        font-size: 17px;
        color: #fff;
    }

    .bg-welfare-left ul li a {
        color: #fff;
        text-decoration: none;
    }

    .bg-welfare-left ul li a:hover {
        text-decoration: underline;
    }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0"
        style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold text-uppercase">
                        Circuit & Simulation Lab
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none ">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span class="text-uppercase">Circuit & Simulation Lab</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_ELE_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Circuit &amp; Simulation Lab</h2>
                <hr />
                <div class="row mt-2">

                    <div class="col-sm-7">
                        <p class="welfare-font">
                            The Circuit and Simulation Laboratory strengthens students’ understanding of electrical
                            and electronic circuit behavior through the integration of theoretical analysis, hardware
                            experimentation, and software-based simulation. The laboratory supports the analysis of DC
                            and AC circuits, network theorems, and basic electronic circuits using industry-relevant
                            simulation tools. By combining simulation with practical implementation, students enhance
                            conceptual clarity, design validation, and troubleshooting skills, building a strong
                            foundation for advanced studies and real-world engineering applications.
                        </p>
                    </div>
                    <div class="col-lg-5">
                        <img src="~/Content/img/Circuit_Simulation_Lab.jpg" class="p-1"
                            style="height:250px;width:100%;border:1px dashed #000;object-fit:cover" />
                    </div>
                </div>




                <h4 class="welfare-font fw-bold">List of Experiments</h4>

                <ul class="experiment-list welfare-font" style="list-style-type:disc;">
                    <li>Verification of the principle of superposition with AC sources using Multisim / PSPICE</li>
                    <li>Verification of Thevenin and Maximum Power Transfer theorems in AC circuits using Multisim /
                        PSPICE</li>
                    <li>Verification of Norton theorem in AC circuits using Multisim / PSPICE</li>
                    <li>Verification of Tellegen’s theorem for two networks of the same topology using Multisim / PSPICE
                    </li>
                    <li>
                        Determination of Z and h-parameters (DC only) for a network and computation of Y and
                        ABCD parameters using Multisim / PSPICE
                    </li>
                    <li>
                        Determination of driving point and transfer functions of a two-port ladder network and
                        verification with theoretical values using Multisim / PSPICE
                    </li>
                    <li>
                        Determination of the transient response of current in RL and RC circuits with step
                        voltage input
                    </li>
                    <li>
                        Determination of the transient response of current in RLC circuit with step voltage
                        input for under-damped, critically damped, and over-damped cases
                    </li>
                </ul>
                </section>





            </div>
        </div>
    </div>
</div>