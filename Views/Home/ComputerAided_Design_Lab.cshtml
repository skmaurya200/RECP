@{
    
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Computer-Aided Design (CAD) Laboratory
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Computer-Aided Design (CAD) Laboratory</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_MCHE_Sidebar.cshtml")

        <style>
                    table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 16px;
                        margin-top: 20px;
                    }

                        table th {
                            background-color: #0747AE;
                            color: #fff;
                            font-weight: bold;
                            padding: 10px;
                            border: 1px solid #0747AE;
                        }

                        table td {
                            border: 1px solid #ddd;
                            padding: 10px;
                            text-align: center;
                            background-color: #fafafa;
                        }

                        table tr:hover td {
                            background-color: #f1f5ff;
                        }
        </style>

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Computer-Aided Design (CAD) Laboratory</h2>
                <hr />
               <div class="row">
			   <div class="col-sm-7">
			   <p class="welfare-font" style="margin-top:10px;"> The computer-aided design (CAD) laboratory is a core facility that equips students with modern tools and techniques used in engineering design. The lab is equipped with high-performance computer systems and licensed industry-standard software, including AutoCAD, SolidWorks, and other modelling and simulation tools. It plays a crucial role in transforming theoretical design knowledge into practical engineering applications. Students learn to:</p>
                
			   </div>
			   <div class="col-sm-5">
			   <img src="~/Content/DEPIMG/Computer-Aided Design(CAD)Laboratory.jpg" style="border:1px dashed black; padding:5px; margin-top:10px;"/>
			   </div>
			   </div>
			   <ul class="welfare-font" style="list-style-type:disc !important; margin-left:20px; margin-top:-10px;">
                    <li>Perform 2D drafting and 3D modelling</li>
                    <li>Create assembly drawings</li>
                    <li>Carry out design analysis and visualisation</li>
                    <li>The lab effectively bridges theoretical design concepts with real-world engineering practice, fostering innovation, precision, and problem-solving skills required for industry-oriented design challenges.</li>
                    
                </ul>
				</div>
            </div>
        </div>
    </div>
</div>



























