@{
    ViewBag.Title = "Course Of Study";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@media(max-width:1100px) {
        .gdgd {
            height: 200px !important;
        }

        .fgfg {
            font-size: 1.1em;
        }
    }
</style>
<div class="row">
    <div class="col-md-12 p-0" style="margin-top: -20px; background: url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') no-repeat center center; background-size: cover; background-attachment:fixed; ">
        <div class="container-fluid" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height: 300px">
                    <h3 class="display-6 text-white text-uppercase fw-bold">Course Of Study</h3>
                    <div class="d-inline-flex text-white">
                        <p class="m-0 text-uppercase"><a class="text-white" href="/" style="text-decoration:none;">Home</a></p>
                        <i class="fa fa-angle-double-right pt-1 px-3"></i>
                        <p class="m-0 text-uppercase text-light">Course Of Study</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="content-section py-5">
    <div class="container">

        <!-- Civil Engineering -->
        <div class="row align-items-center mb-5 rounded-4 p-4 shadow department-card bg-light bg-opacity-75">
            <div class="col-md-6">
                <img src="~/Content/img/image/civil.jpg" style="height:360px !important;" class="img-fluid rounded-4 shadow w-100" alt="Civil Engineering">
            </div>
            <div class="col-md-6 mt-3 mt-md-0">
                <h4 class="fw-bold  mb-3 fw-bold" style="color:#0747ae; font-size:19px;">Civil Engineering</h4>
                <hr style="border-bottom:1px solid black;" />
                <p class="text-dark" style="line-height:34px; text-align:justify;">
                    The program primarily focuses on Structural Engineering, Geotechnical Engineering, and advanced Construction Technologies. It offers hands-on experience in design of structures, soil testing, construction materials, project management, and sustainable infrastructure. Students also gain practical exposure through lab sessions, site visits, and real-world projects, preparing them for industry roles in core civil engineering domains.
                </p>
                <button class="btn btn-outline-success mt-3 px-4 py-2 fw-semibold rounded-pill">Annual Intake: 60 Students</button>
            </div>
        </div>

        <!-- Computer Science and Engineering -->
        <div class="row align-items-center mb-5 rounded-4 p-4 shadow department-card bg-light bg-opacity-75">
            <div class="col-md-6 order-md-2">
                <img src="https://indusuni.ac.in/wp-content/uploads/2019/03/computer-lab.jpg" class="img-fluid rounded-4 shadow" alt="Computer Science and Engineering">
            </div>
            <div class="col-md-6 mt-3 mt-md-0">
                <h4 class="fw-bold  mb-3" style=" color: #0747ae; font-size: 19px;">Computer Science and Engineering</h4>
                <hr style="border-bottom:1px solid black;" />
                <p class="text-dark" style="line-height:34px; text-align:justify;">
                    The program primarily focuses on Algorithms, Data Structures, Artificial Intelligence, and advanced Computing Technologies. It offers hands-on experience in programming, database systems, software development, machine learning, and cloud computing. Students also gain practical exposure through coding labs, hackathons, and industry-driven projects, preparing them for diverse roles in the tech industry and research.
                </p>
                <button class="btn btn-outline-success mt-3 px-4 py-2 fw-semibold rounded-pill">Annual Intake: 60 Students</button>
            </div>
        </div>

        <!-- Electrical Engineering -->
        <div class="row align-items-center mb-5 rounded-4 p-4 shadow department-card bg-light bg-opacity-75">
            <div class="col-md-6">
                <img src="https://osuonline.okstate.edu/programs/images/ee-student-working-in-lab.jpg" style="height:360px !important;" class="w-100 img-fluid rounded-4 shadow" alt="Electrical Engineering">
            </div>
            <div class="col-md-6 mt-3 mt-md-0">
                <h4 class="fw-bold mb-3" style=" color: #0747ae; font-size: 19px;">Electrical Engineering</h4>
                <hr style="border-bottom:1px solid black;" />
                <p class="text-dark" style="line-height:34px; text-align:justify">
                    The program primarily focuses on Power Systems, Control Systems, Electrical Machines, and advanced Energy Technologies. It offers hands-on experience in circuit analysis, power electronics, renewable energy systems, instrumentation, and automation. Students also gain practical exposure through lab experiments, hardware projects, and simulations, preparing them for industry roles in core electrical and energy sectors.
                </p>
                <button class="btn btn-outline-success mt-3 px-4 py-2 fw-semibold rounded-pill">Annual Intake: 60 Students</button>
            </div>
        </div>

        <!-- Mechanical Engineering -->
        <div class="row align-items-center mb-5 rounded-4 p-4 shadow department-card bg-light bg-opacity-75">
            <div class="col-md-6 order-md-2">
                <img src="https://i1.wp.com/famt.ac.in/wp-content/uploads/2015/08/MG_9096.jpg?fit=2808%2C1872" style="height:360px !important;" class="w-100 img-fluid rounded-4 shadow" alt="Mechanical Engineering">
            </div>
            <div class="col-md-6 mt-3 mt-md-0">
                <h4 class="fw-bold mb-3" style=" color: #0747ae; font-size: 19px;">Mechanical Engineering</h4>
                <hr style="border-bottom:1px solid black;" />
                <p class="text-dark" style="line-height: 34px; text-align:justify;">
                    The program primarily focuses on Thermodynamics, Fluid Mechanics, Manufacturing Processes, and advanced Mechanical Systems. It offers hands-on experience in CAD/CAM, heat transfer, machine design, robotics, and materials engineering. Students also gain practical exposure through lab work, industrial training, and design projects, preparing them for roles in core mechanical industries and research domains.
                </p>
                <button class="btn btn-outline-success mt-3 px-4 py-2 fw-semibold rounded-pill">Annual Intake: 60 Students</button>
            </div>
        </div>

    </div>
</div>


<!-- Custom Styles -->
<style>
    .content-section {
        background: linear-gradient(to right, #f9f9f9, #fff);
    }

    .department-card {
        transition: all 0.3s ease-in-out;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(200, 200, 200, 0.3);
    }

        .department-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
        }

    h3.text-primary {
        color: #b22222 !important;
    }

    @@media (max-width: 768px) {
        .department-card {
            text-align: center;
        }

            .department-card img {
                max-height: 250px;
                object-fit: cover;
            }
    }
</style>
</div>