</style>
<!-- Banner Section -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top: -20px; background: url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') no-repeat center center; background-size: cover; background-attachment:fixed; ">
        <div class="container-fluid" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="container">
