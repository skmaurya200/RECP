@model Rec_Partapgarh.Models.DeptFacultyViewModel
@{
    ViewBag.Title = Model.DepartmentName + " Faculty";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Our Faculty
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Our Faculty</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
        @Html.Partial(Model.SidebarPath)

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Our Faculty</h2>
                <hr />


                <div class="row g-4 mt-2">

                    @foreach (var faculty in Model.Faculty)
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="faculty-card">
                                <img src="@Url.Content(faculty.PhotoPath)" alt="@faculty.FullName">
                                <div class="card-body">
                                    <h5><a href="@Url.Action("Faculty_Profile", "Home", new { token = faculty.ProfileToken })">@faculty.FullName</a></h5>
                                    <p>@faculty.Designation</p>
                                    <span>@faculty.Qualification</span>
                                    <div class="mt-3">
                                        <a href="@Url.Action("Faculty_Profile", "Home", new { token = faculty.ProfileToken })" class="btn btn-outline-primary btn-profile">View Profile</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (!Model.Faculty.Any())
                    {
                        <div class="col-12">
                            <p class="welfare-font mb-0">No faculty records available for @Model.DepartmentName.</p>
                        </div>
                    }

                </div>


                <style>
                    .faculty-card {
                        border: 1px dashed black;
                        border-radius: 0px;
                        overflow: hidden;
                        transition: 0.3s ease;
                        height: 100%;
                        background: #fff;
                    }

                        .faculty-card:hover {
                            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
                            transform: translateY(-5px);
                        }

                        .faculty-card img {
                            width: 100%;
                            height: 260px;
                            object-fit: center;
                        }

                        .faculty-card .card-body {
                            text-align: center;
                            padding: 15px;
                        }

                        .faculty-card h5 {
                            font-size: 15px;
                            font-weight: 600;
                            color: #0747AE;
                            margin-bottom: 5px;
                        }

                        .faculty-card p {
                            font-size: 15px;
                            margin-bottom: -5px;
                        }

                        .faculty-card span {
                            font-size: 14px;
                            color: #555;
                        }

                    .btn-profile {
                        font-size: 14px;
                        padding: 5px 15px;
                        border-radius: 20px;
                    }
                </style>

            </div>
        </div>
    </div>
</div>
