
@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold text-uppercase">
                        Vision & Mission
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none ">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span class="text-uppercase">Vision & Mission</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_ELE_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Vision</h2>
                <hr />
                <p class="welfare-font" style="margin-top:10px;">
                    To be a centre of excellence in electrical engineering education by fostering academic excellence, innovation, and research, and by producing competent, ethical, and industry-ready professionals who contribute effectively to technological advancement, sustainable development and the betterment of society.
                </p>
            </div>
			 <div class="content-box mt-2">

                <h2 class="fw-bold" style="color:#0747AE;">Mission</h2>
                <hr />
                <ul class="welfare-font" style="list-style-type:disc; margin-top:10px;">
                    <li>To deliver high-quality education with a strong foundation in electrical engineering principles
                        and practices.</li>
                    <li>To develop analytical, design, and problem-solving skills through effective teaching,
                        laboratories, and industry interaction.</li>
                    <li>To promote research, innovation, and the adoption of emerging technologies in the field of
                        electrical engineering.</li>
                    <li>To inculcate professional ethics, leadership qualities, and a commitment to lifelong learning.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
























