@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

    .bg-welfare-left h3 {
        font-size: 21px;
        font-weight: 600;
        color: #fff;
    }

    .bg-welfare-left ul li {
        margin-top: 18px;
        font-size: 17px;
        color: #fff;
    }

    .bg-welfare-left ul li a {
        color: #fff;
        text-decoration: none;
    }

    .bg-welfare-left ul li a:hover {
        text-decoration: underline;
    }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0"
        style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold text-uppercase">
                        Electrical Machine Lab
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none ">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span class="text-uppercase">Electrical Machine Lab</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_ELE_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Electrical Machine Lab</h2>
                <hr />
                <div class="row mt-2">

                    <div class="col-sm-7">
                        <p class="welfare-font">
                            The Electrical Machine Laboratory provides undergraduate students with practical exposure to
                            transformers and rotating electrical machines, complementing classroom learning. Students
                            perform
                            experiments on DC and AC motors, generators, and single- and three-phase transformers to
                            study their
                            performance, efficiency, and operational characteristics. The laboratory strengthens
                            students’
                            understanding of real-world machine behavior and power system applications.
                        </p>
                    </div>
                    <div class="col-lg-5">
                        <img src="~/Content/img/Electrical_Machine_Lab.jpg" class="p-1"
                            style="height:220px;width:100%;border:1px dashed #000;object-fit:cover" />
                    </div>
                </div>


                <p class="welfare-font fw-bold">List of Experiments</p>
                <ul class="welfare-font" style="list-style-type:disc !important;">
                    <li>To obtain the magnetization characteristics of a DC shunt generator.</li>
                    <li>To obtain load characteristics of a DC shunt generator and compound generator (a) Cumulatively
                        compounded, (b) Differentially compounded. </li>
                    <li>To obtain the efficiency of a DC shunt machine using Swinburne’s test.</li>
                    <li>To perform Hopkinson’s test and determine losses and efficiency of the DC machine. </li>
                    <li>To obtain speed- torque characteristics of a DC shunt motor. </li>
                    <li>To obtain speed control of a DC shunt motor using (a) armature resistance control, (b) field
                        control</li>
                    <li>To obtain speed control of a DC separately excited motor using Ward-Leonard. </li>
                    <li>To obtain the equivalent circuit, efficiency and voltage regulation of a single-phase
                        transformer using O.C. and S.C. tests. </li>
                </ul>
            </div>
        </div>
    </div>
</div>