@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

    .bg-welfare-left h3 {
        font-size: 21px;
        font-weight: 600;
        color: #fff;
    }

    .bg-welfare-left ul li {
        margin-top: 18px;
        font-size: 17px;
        color: #fff;
    }

    .bg-welfare-left ul li a {
        color: #fff;
        text-decoration: none;
    }

    .bg-welfare-left ul li a:hover {
        text-decoration: underline;
    }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0"
        style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold text-uppercase">
                        Electrical Workshop Lab
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none ">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span class="text-uppercase">Electrical Workshop Lab</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_ELE_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Electrical Workshop Lab</h2>
                <hr />



                <div class="row mt-2">

                    <div class="col-sm-7">
                        <p class="welfare-font">
                            The Electrical Workshop Laboratory provides hands-on training in fundamental electrical
                            practices for students of electrical and related engineering branches. Equipped with
                            essential instruments and machines, the lab enables experiments on wiring, electrical
                            measurements, motor control, transformer testing, and fault detection. Emphasis on safety
                            and standard procedures helps students connect theory with real-world applications and
                            develop practical skills for engineering practice.
                        </p>
                    </div>
                    <div class="col-lg-5">
                        <img src="~/Content/img/Electrical_Workshop_Lab.jpg" class="p-1"
                            style="height:220px;width:100%;border:1px dashed #000;object-fit:cover" />
                    </div>
                </div>

                <h4 class="welfare-font fw-bold">List of Experiments</h4>

                <ul class="welfare-font" style="list-style-type:disc !important;">
                    <li>To study the working and control of two lamps in series and in parallel</li>
                    <li>To perform the staircase working and its testing</li>
                    <li>To study the working principle and wiring of a fluorescent lamp</li>
                    <li>
                        To study the wiring of the distribution board, including the power plug using an
                        isolator, MCB, and ELCB
                    </li>
                    <li>To study and estimate a typical BHK house wiring</li>
                    <li>
                        Familiarisation, soldering, testing, and observing the waveforms on CRO of an HW and
                        FW uncontrolled rectifier (using diodes) with a capacitor filter
                    </li>
                    <li>
                        Visit the college substation and familiarise with the supply system, transformer,
                        HT panel, and land distribution
                    </li>
                    <li>
                        To study the construction, working, and application of workshop tools, along with
                        electrical and electronics symbols
                    </li>
                </ul>
                </section>

            </div>
        </div>
    </div>
</div>