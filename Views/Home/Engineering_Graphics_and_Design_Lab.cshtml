@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

    .bg-welfare-left h3 {
        font-size: 21px;
        font-weight: 600;
        color: #fff;
    }

    .bg-welfare-left ul li {
        margin-top: 18px;
        font-size: 17px;
        color: #fff;
    }

    .bg-welfare-left ul li a {
        color: #fff;
        text-decoration: none;
    }

    .bg-welfare-left ul li a:hover {
        text-decoration: underline;
    }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0"
        style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Engineering Graphics and Design Lab
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Engineering Graphics and Design Lab</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_CVLE_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Engineering Graphics and Design Lab</h2>
                <hr />
                <div class="row mt-2">
                    <div class="col-lg-5">
                        <img src="~/Content/img/Engineering_Graphics_and_Design_Lab.jpg" class="p-1"
                            style="height:250px;width:100%;border:1px dashed #000;object-fit:cover" />
                    </div>
                    <div class="col-sm-7">
                        <p class="welfare-font">
                            The Engineering Graphics and Design Lab helps students learn how to represent ideas and
                            objects through drawings. In this lab, students practice creating technical sketches,
                            reading engineering drawings, and developing accurate 2D and 3D models. It builds the
                            fundamental skills required to clearly communicate engineering concepts and prepare designs
                            used in real-world construction and manufacturing activities.
                            The lab is well-equipped with 75 adjustable drawing tables, providing ample space and
                            flexibility for practical hands-on learning.
                        </p>
                    </div>

                </div>
                <p class="welfare-font" style="font-weight:700;">List of Experiments</p>
                <ul class="welfare-font" style="list-style-type:disc !important;">
                    <li>Introduction to engineering drawing and orthographic projections.</li>
                    <li>Projection of planes and solids.</li>
                    <li>Sections of regular solids and development of surfaces.</li>
                    <li>Isometric projection.</li>
                    <li>Introduction to computer-aided design.</li>
                </ul>

            </div>

        </div>

    </div>
</div>