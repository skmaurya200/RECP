@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Fluid Mechanics Laboratory
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Fluid Mechanics Laboratory</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_MCHE_Sidebar.cshtml")

        <style>
                    table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 16px;
                        margin-top: 20px;
                    }

                        table th {
                            background-color: #0747AE;
                            color: #fff;
                            font-weight: bold;
                            padding: 10px;
                            border: 1px solid #0747AE;
                        }

                        table td {
                            border: 1px solid #ddd;
                            padding: 10px;
                            text-align: center;
                            background-color: #fafafa;
                        }

                        table tr:hover td {
                            background-color: #f1f5ff;
                        }
        </style>

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Fluid Mechanics Laboratory</h2>
                <hr />


               <div class="row">
			   <div class="col-sm-7">
			    <p class="welfare-font" style="margin-top:10px;">
                    The fluid mechanics laboratory enables students to study the fundamental principles governing fluid behaviour experimentally. Through hands-on experiments, students gain practical insight into fluid properties, flow measurement, pipe losses, and the performance of hydraulic machines, thereby strengthening their understanding of theoretical concepts and real-world engineering applications.
                </p>
				 <p style="color:black; font-weight:600; font-size:17px">List of experiments</p>
                <ul class="welfare-font" style="list-style-type:disc !important; margin-left:20px; margin-top:-10px;">
                    <li>Fluid properties and pressure measurement</li>
                    <li>Flow through pipes and losses</li>
                    <li>Bernoulli’s theorem</li>
                    <li>Metacentric height</li>
                    <li>Performance testing of hydraulic machines</li>
                </ul>
			   </div>
			   <div class="col-sm-5">
			   <img src="~/Content/DEPIMG/Fluid Mechanics Laboratory.png"  style="border:1px dashed black; padding:5px; margin-top:10px;"/>
			   </div>
			   </div>

                
                <p class="welfare-font" style="margin-top:10px;">
                    The laboratory is equipped with modern experimental setups that enhance analytical skills and prepare students for careers in mechanical, civil, and energy engineering.
                </p>
            </div>
        </div>
    </div>
</div>



























