@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

    .bg-welfare-left h3 {
        font-size: 21px;
        font-weight: 600;
        color: #fff;
    }

    .bg-welfare-left ul li {
        margin-top: 18px;
        font-size: 17px;
        color: #fff;
    }

    .bg-welfare-left ul li a {
        color: #fff;
        text-decoration: none;
    }

    .bg-welfare-left ul li a:hover {
        text-decoration: underline;
    }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0"
        style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold text-uppercase">
                        Fundamental of Electronics Engineering Lab
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none ">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span class="text-uppercase">Fundamental of Electronics Engineering Lab</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_ELE_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Fundamental of Electronics Engineering Lab</h2>
                <hr />
                <div class="row mt-2">
                    <div class="col-sm-7">
                        <p class="welfare-font" style="margin-top:10px;">
                            The Fundamentals of Electronics Engineering Laboratory provides hands-on exposure to the
                            principles of analog and digital electronics for undergraduate students. Equipped with
                            modern instruments and trainer kits, the lab supports experiments on semiconductor devices,
                            analog circuits, and basic digital systems. Through practical sessions, students develop
                            circuit analysis, design, and problem-solving skills, building a strong foundation for
                            advanced studies and interdisciplinary engineering applications.
                        </p>
                    </div>
                    <div class="col-lg-5">
                        <img src="~/Content/img/Fundamental_Electronics_Engineering_Lab1.jpg" class="p-1"
                            style="height:250px;width:100%;border:1px dashed #000;object-fit:cover" />
                    </div>
                </div>
                <h4 class="welfare-font fw-bold">List of Experiments</h4>

                <ul class="welfare-font" style="list-style-type:disc !important;">
                    <li>
                        Study of lab equipment and components: CRO, multimeter, function generator, power
                        supply, active and passive components, and breadboard
                    </li>
                    <li>
                        P-N junction diode: characteristics of PN junction diode – static and dynamic resistance
                        measurement from graph
                    </li>
                    <li>
                        Applications of PN junction diode: half and full wave rectifier, measurement of Vrms,
                        Vdc, and ripple factor
                    </li>
                    <li>
                        Characteristics of Zener diode: V-I characteristics of Zener diode, graphical
                        measurement of forward and reverse resistance
                    </li>
                    <li>Characteristic of BJT: BJT in CE configuration</li>
                    <li>To study the operational amplifier as an adder and subtractor</li>
                    <li>Verification of the truth table of various logic gates</li>
                    <li>
                        Implementation of the given Boolean function using logic gates in both SOP and POS forms
                    </li>
                </ul>
                </section>


            </div>
        </div>
    </div>
</div>