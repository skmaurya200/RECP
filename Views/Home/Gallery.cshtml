@{
    ViewBag.Title = "Gallery";
}

<div class="row">
    <div class="col-md-12 p-0" style="background: url('https://static.vecteezy.com/system/resources/thumbnails/049/725/830/small_2x/closeup-of-a-stack-of-books-at-a-local-library-a-resource-for-families-to-gather-and-learn-together-photo.jpg') no-repeat center center; background-size: cover;">
        <div class="container-fluid" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height: 300px">
                    <h3 class="display-7 text-white text-uppercase fw-bold">Gallery</h3>
                    <div class="d-inline-flex text-white">
                       <p class="m-0 text-uppercase"><a class="text-white" href="/" style="text-decoration:none;">Home</a></p>
                        <i class="fa fa-angle-double-right pt-1 px-3"></i>
                        <p class="m-0 text-uppercase">Gallery</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .gallery-img {
        width: 100%; /* Column width ke according adjust */
        height: 200px; /* Fixed height for uniform size */
        object-fit: cover; /* Crop and fit image properly */
        border-radius: 5px; /* Rounded corners */
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1); /* Light shadow for better look */
    }
</style>

<div class="container mt-5">
    <h2 class="fw-bold text-center" style="color: #0747ae;">Gallery</h2>
    <hr style="border-bottom: 2px solid black; width: 60px; margin: auto;">

    <div class="row mt-4">
        @foreach (var item in ViewBag.GalleryImg)
        {
            <div class="col-md-3 mb-3">
                <img src="~/Content/recp/upload/Gellary/@item.Image" class="gallery-img" alt="Gallery Image">
            </div>
        }
    </div>
</div>

