@model List<Rec_Partapgarh.Models.PublicGalleryCategoryViewModel>
@using System.Text.RegularExpressions

@{
    ViewBag.Title = "Gallery";
}
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600&display=swap" rel="stylesheet">
@functions {
    public int GetYearFromCategory(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return 0;

        var match = Regex.Match(name, @"\b(19|20)\d{2}\b");

        if (match.Success)
            return Convert.ToInt32(match.Value);

        return 0;
    }
}

<style>
    /* ===== ORIGINAL CSS (UNCHANGED) ===== */
    .gallery-box {
        position: relative;
        overflow: hidden;
        border-radius: 10px;
        transition: transform 0.3s ease;
        background: #f5f5f5;
    }

        .gallery-box:hover {
            transform: scale(1.03);
        }

        .gallery-box img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 10px;
            display: block;
        }

    .overlay-icon {
        position: absolute;
        top: 0;
        left: 0;
        background: rgba(0, 0, 0, 0.6);
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
    }

    .gallery-box:hover .overlay-icon {
        opacity: 1;
    }

    .overlay-icon i {
        font-size: 2rem;
        color: #fff;
    }

    @@media (max-width: 768px) {
        .gallery-box img {
            height: 180px;
        }
    }

    /* ===== ONLY MODAL CSS (NEW) ===== */
    .img-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.85);
        z-index: 99999;
    }

        .img-modal img {
            max-width: 90%;
            max-height: 80vh;
            margin: auto;
            display: block;
            margin-top: 5%;
            border-radius: 6px;
        }

        .img-modal .close {
            position: absolute;
            top: 20px;
            right: 30px;
            font-size: 40px;
            color: #fff;
            cursor: pointer;
        }

    .gallery-category-title {
        color: #0747AE !important;
        font-family: 'Arial', 'Noto Sans Devanagari', sans-serif;
        font-size: 17px;
        font-weight: 600;
        line-height: 1.4;
        letter-spacing: normal;
        font-style: normal;
        text-align: justify;
    }
</style>

<!-- ===== BANNER (UNCHANGED) ===== -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') no-repeat center;
        background-size:cover; background-attachment:fixed;">
        <div class="container-fluid" style="background-color:rgba(0,0,0,0.5);">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px">
                    <h3 class="display-6 text-white text-uppercase fw-bold">Our Gallery</h3>
                    <div class="d-inline-flex text-white">
                        <p class="m-0 text-uppercase">
                            <a class="text-white" href="/" style="text-decoration:none;">Home</a>
                        </p>
                        <i class="fa fa-angle-double-right pt-1 px-3"></i>
                        <p class="m-0 text-uppercase text-light">Our Gallery</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== GALLERY ===== -->
@foreach (var cat in Model
    .OrderByDescending(x => x.Images != null && x.Images.Any() ? x.Images.Max(i => i.GalleryId) : 0)
    .ThenByDescending(x => GetYearFromCategory(x.CategoryName))
    .ThenBy(x => x.CategoryName))
{
    var orderedImages = cat.Images != null
        ? cat.Images.OrderByDescending(x => x.GalleryId).ToList()
        : null;

    <div class="container category-block">
        @using System.Text.RegularExpressions

		<h1 class="mt-5 mb-3 pb-2 text-capitalize gallery-category-title">
			@cat.CategoryName
		</h1>

        <div class="row">
            @if (orderedImages != null)
            {
                foreach (var img in orderedImages)
                {
                    var imageUrl = Url.Content(img.ImagePath);
                    <div class="col-md-3 mb-4">
                        <div class="gallery-box" data-full="@imageUrl" onclick="openImg(this)">
                            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACw="
                                 data-src="@imageUrl"
                                 alt="@(string.IsNullOrWhiteSpace(img.Title) ? cat.CategoryName : img.Title)"
                                 loading="lazy"
                                 decoding="async"
                                 class="gallery-lazy" />

                            <div class="overlay-icon">
                                <i class="fa fa-plus"></i>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

<!-- ===== IMAGE MODAL ===== -->
<div id="imgModal" class="img-modal">
    <span class="close" onclick="closeImg()">&times;</span>
    <img id="imgModalSrc" />
</div>

<script>
    function openImg(box) {
        var src = box.getAttribute("data-full");

        document.getElementById("imgModalSrc").src = src;
        document.getElementById("imgModal").style.display = "block";
    }

    function closeImg() {
        document.getElementById("imgModal").style.display = "none";
        document.getElementById("imgModalSrc").src = "";
    }

    document.getElementById("imgModal").addEventListener("click", function (e) {
        if (e.target.id === "imgModal") {
            closeImg();
        }
    });

    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
            closeImg();
        }
    });

    // ===== 100VH BASED LAZY LOADING =====
    // Page open hone par sirf visible screen ki images load hongi.
    // Scroll karte time next images automatically load hongi.
    (function () {
        function loadGalleryImage(img) {
            var src = img.getAttribute("data-src");

            if (!src) return;

            img.src = src;
            img.removeAttribute("data-src");
        }

        var lazyImages = document.querySelectorAll(".gallery-lazy");

        if ("IntersectionObserver" in window) {
            var imageObserver = new IntersectionObserver(function (entries, observer) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        loadGalleryImage(entry.target);
                        observer.unobserve(entry.target);
                    }
                });
            }, {
                root: null,
                rootMargin: "0px",
                threshold: 0.01
            });

            lazyImages.forEach(function (img) {
                imageObserver.observe(img);
            });
        } else {
            lazyImages.forEach(function (img) {
                loadGalleryImage(img);
            });
        }
    })();
</script>

