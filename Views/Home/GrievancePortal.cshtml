@{
    ViewBag.Title = "Student Grievance Portal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row">
    <div class="col-md-12 p-0" style="background: url('https://static.vecteezy.com/system/resources/thumbnails/049/725/830/small_2x/closeup-of-a-stack-of-books-at-a-local-library-a-resource-for-families-to-gather-and-learn-together-photo.jpg') no-repeat center center; background-size: cover;">
        <div class="container-fluid" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height: 300px">
                    <h3 class="display-7 text-white text-uppercase fw-bold">Student Grievance Portal</h3>
                    <div class="d-inline-flex text-white">
                       <p class="m-0 text-uppercase"><a class="text-white" href="/" style="text-decoration:none;">Home</a></p>
                        <i class="fa fa-angle-double-right pt-1 px-3"></i>
                        <p class="m-0 text-uppercase">Student Grievance Portal</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row p-3 mt-4">
        <div class="col-sm-12">
            <h4 style="color:#0747ae;" class="fw-bold">Student Grievance Portal</h4>
            <hr style="border:1px solid black;" />
            <div class="container-fluid mt-4">

                @using (Html.BeginForm("SubmitGrievance", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="row g-3 border-1 border p-3">
                        <div class="col-md-6">
                            <label class="form-label">Name of the Student</label>
                            <input type="text" name="StudentName" class="form-control rounded-0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Father’s Name</label>
                            <input type="text" name="FatherName" class="form-control rounded-0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Registration No./Roll No.</label>
                            <input type="text" name="RollNumber" class="form-control rounded-0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Course & Branch</label>
                            <input type="text" name="CourseBranch" class="form-control rounded-0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contact No.</label>
                            <input type="text" name="ContactNo" class="form-control rounded-0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email ID</label>
                            <input type="email" name="Email" class="form-control rounded-0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date & Time</label>
                            <input type="datetime-local" name="DateTime" class="form-control rounded-0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Place</label>
                            <input type="text" name="Place" class="form-control rounded-0">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Detail of Incident</label>
                            <textarea class="form-control rounded-0" name="IncidentDetails" rows="3"></textarea>
                        </div>
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </div>
                    
                }
                </div>
        </div>
    </div>
</div>
                
