
@{
    ViewBag.Title = "Hostels";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12 p-0" style="background: url('https://static.vecteezy.com/system/resources/thumbnails/049/725/830/small_2x/closeup-of-a-stack-of-books-at-a-local-library-a-resource-for-families-to-gather-and-learn-together-photo.jpg') no-repeat center center; background-size: cover;">
        <div class="container-fluid" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height: 300px">
                    <h3 class="display-7 text-white text-uppercase fw-bold">Hostel Facilities</h3>
                    <div class="d-inline-flex text-white">
                       <p class="m-0 text-uppercase"><a class="text-white" href="/" style="text-decoration:none;">Home</a></p>
                        <i class="fa fa-angle-double-right pt-1 px-3"></i>
                        <p class="m-0 text-uppercase">Hostel Facilities</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container mt-5 mb-4">
    <div class="row">
        <div class="col-12 text-center">
            <h4 class="fw-bold"></h4>
            <hr class="border border-dark" />
        </div>
    </div>

    <div class="row g-4 text-center">
        <div class="col-md-3">
            <img src="https://www.sonatech.ac.in/photo-gallery/hostel/images/hostel-room.jpg" class="img-fluid rounded" alt="Hostel Image">
        </div>
        <div class="col-md-3">
            <img src="https://th.bing.com/th/id/OIP.6ZbBfZHnaB9SZVpPE27s4gHaE5?w=307&h=203&c=8&rs=1&qlt=90&o=6&dpr=1.3&pid=3.1&rm=2" class="img-fluid rounded" alt="Hostel Image">
        </div>
        <div class="col-md-3">
            <img src="https://amtgi.co.in/assets/images/blog/latest-blog/h3.jpg" class="img-fluid rounded" alt="Hostel Image">
        </div>
        <div class="col-md-3">
            <img src="https://th.bing.com/th/id/R.93f55a84d953441727207ad3b06ea974?rik=tvC93kwGCdUtyA&riu=http%3a%2f%2fwww.acdegreecollege.com%2fimages%2fgirlshostel.jpg&ehk=EP6sXC20Xg%2bE2LtQ7Jz6kQgWqWut63ZLY6yfHfiL%2bXA%3d&risl=&pid=ImgRaw&r=0" class="img-fluid rounded" alt="Hostel Image">
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <p class="text-justify" style="line-height: 1.8;">
                Rajkiya Engineering College provides 8 hostels for students: 2 for girls, 5 for boys, and 1 under construction. The hostels offer single, double, and triple-seater rooms with a safe and secure environment monitored by security personnel.
            </p>
            <h5 class="fw-bold" style="color:#0747ae;">Hostel Rules & Regulations</h5>
            <hr class="border border-dark" />
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><i class="fas fa-ban"></i> Ragging is strictly prohibited, and violations will lead to disciplinary action.</li>
                <li class="list-group-item"><i class="fas fa-user-shield"></i> Students must maintain discipline and respect institute rules.</li>
                <li class="list-group-item"><i class="fas fa-user-friends"></i> Visitors must seek prior approval from the warden.</li>
                <li class="list-group-item"><i class="fas fa-door-closed"></i> Switching rooms without permission is prohibited.</li>
                <li class="list-group-item"><i class="fas fa-plug"></i> Electric appliances like heaters and toasters require prior approval.</li>
                <li class="list-group-item"><i class="fas fa-glass-martini-alt"></i> Alcohol, drugs, and gambling are strictly forbidden.</li>
                <li class="list-group-item"><i class="fas fa-clock"></i> Hostel curfew is at 10:00 PM; late entries require warden approval.</li>
                <li class="list-group-item"><i class="fas fa-couch"></i> Furniture and electrical fittings must not be tampered with.</li>
                <li class="list-group-item"><i class="fas fa-users-cog"></i> Students are not allowed to participate in unauthorized meetings or strikes.</li>
            </ul>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <h5 class="fw-bold" style="color:#0747ae;">Amenities</h5>
            <hr class="border border-dark" />
            <div class="row">
                <div class="col-md-6">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><i class="fas fa-bed"></i> Furnished rooms with curtains, mattresses, and wardrobes.</li>
                        <li class="list-group-item"><i class="fas fa-utensils"></i> Mess & dining facilities.</li>
                        <li class="list-group-item"><i class="fas fa-wifi"></i> High-speed Wi-Fi access.</li>
                        <li class="list-group-item"><i class="fas fa-sun"></i> Solar water heaters for hot water.</li>
                        <li class="list-group-item"><i class="fas fa-dumbbell"></i> Well-equipped gymnasium.</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><i class="fas fa-tv"></i> Common TV room.</li>
                        <li class="list-group-item"><i class="fas fa-book"></i> Library access.</li>
                        <li class="list-group-item"><i class="fas fa-table-tennis"></i> Indoor games: Table Tennis, Carrom, Chess.</li>
                        <li class="list-group-item"><i class="fas fa-basketball-ball"></i> Outdoor sports: Football, Volleyball, Basketball, Badminton.</li>
                        <li class="list-group-item"><i class="fas fa-bolt"></i> 24/7 power backup.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
