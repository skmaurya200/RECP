@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 19px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        INSTITUTE’S INNOVATION COUNCIL
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>INSTITUTE’S INNOVATION COUNCIL</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
        <!-- LEFT SIDEBAR -->


        <!-- RIGHT CONTENT -->
        <div class="col-lg-12">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">INSTITUTE’S INNOVATION COUNCIL</h2>
                <hr />
                <section class="iic-section" style="margin-top:10px;">

                 

                    <p class="welfare-font">
                        The Institution's Innovation Council (IIC) is an initiative of the
                        Ministry of Education (MoE), Government of India, established to foster
                        a culture of innovation and entrepreneurship in Higher Educational Institutions (HEIs).
                        The program is implemented in collaboration with the Ministry of Education’s
                        Innovation Cell (MIC) and the All India Council for Technical Education (AICTE).
                    </p>

                    <p class="welfare-font">
                        It aims to create a vibrant ecosystem that supports idea generation, pre-incubation,
                        incubation, and the development of student-led start-ups.
                    </p>

                    <h3 class="welfare-font fw-bold">Establishment at the Institute</h3>

                    <p class="welfare-font">
                        It is hereby resolved that the Institute’s Innovation Council (IIC) is constituted at
                        Bharat Ratna Babasaheb Bhimrao Ambedkar Rajkiya Engineering College, Pratapgarh,
                        under the aegis of the Ministry of Education’s Innovation Cell (MIC).
                    </p>

                    <p class="welfare-font">
                        The council functions to nurture creative thinking, entrepreneurial skills, and
                        innovative project development among students and faculty.
                    </p>

                    <h3 class="welfare-font fw-bold">Objectives</h3>

                    <ul class="welfare-font" style="list-style-type:disc !important;">
                        <li class="welfare-font">Promote a culture of innovation, creativity, and problem-solving.</li>
                        <li class="welfare-font">Encourage participation in innovation, start-up development, and entrepreneurial initiatives.</li>
                        <li class="welfare-font">Organize workshops, hackathons, expert lectures, and awareness programs related to innovation and IPR.</li>
                        <li class="welfare-font">Support pre-incubation and incubation activities for student innovators.</li>
                        <li class="welfare-font">Align all activities with the guidelines of MIC/AICTE and maintain regular reporting.</li>
                    </ul>

                    <h3 class="welfare-font fw-bold">Key Functions of the Council</h3>

                    <ul class="welfare-font" style="list-style-type:disc !important;">
                        <li class="welfare-font">Facilitate idea generation and prototype development.</li>
                        <li class="welfare-font">Provide mentorship support through internal and external experts.</li>
                        <li class="welfare-font">Establish collaborations with industry, research bodies, and innovation ecosystems.</li>
                        <li class="welfare-font">Guide students in intellectual property filing, product design, and start-up launch.</li>
                        <li class="welfare-font">Create opportunities for participation in national-level innovation contests and exhibitions.</li>
                    </ul>

                    <h3 class="welfare-font fw-bold">IIC Administration</h3>

                    <p class="welfare-font">
                        IIC Incharge: Dr. Ashish Kumar Mishra, CSED<br>
                        IIC Dy-Incharge: Dr. Nitish Jauhari, CED
                    </p>

                </section>



            </div>
        </div>
    </div>
</div>



















