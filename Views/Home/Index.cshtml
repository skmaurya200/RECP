            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const buttons = document.querySelectorAll(".tab-btn");
                    const contents = document.querySelectorAll(".tab-content");

                    buttons.forEach(btn => {
                        btn.addEventListener("click", function (e) {
                            e.preventDefault();

                            buttons.forEach(b => {
                                b.classList.remove("active");
                                b.style.backgroundColor = "";
                                b.style.color = "";
                            });

                            contents.forEach(c => c.classList.remove("active"));

                            this.classList.add("active");
                            this.style.backgroundColor = "white";
                            this.style.color = "black";

                            const tabId = this.getAttribute("data-tab");
                            document.getElementById(tabId).classList.add("active");
                        });
                    });
                });
            </script>
            <script>
                document.addEventListener("DOMContentLoaded", function () {

                    function startScroll(container) {

                        const content = container.querySelector(".scroll-content");

                        let speed = 0.9;
                        let pos = container.offsetHeight;

                        function animate() {

                            // 🔥 IMPORTANT: tab hidden ho to skip
                            if (container.offsetHeight === 0) {
                                requestAnimationFrame(animate);
                                return;
                            }

                            pos -= speed;

                            // 🔥 pure marquee reset (no duplicate)
                            if (pos <= -content.scrollHeight) {
                                pos = container.offsetHeight;
                            }

                            content.style.transform = `translateY(${pos}px)`;

                            requestAnimationFrame(animate);
                        }

                        animate();

                        // hover pause
                        container.addEventListener("mouseenter", () => speed = 0);
                        container.addEventListener("mouseleave", () => speed = 0.9);
                    }

                    // 🔥 sirf visible tab pe start karo
                    document.querySelectorAll(".tab-content.active .scroll-container")
                        .forEach(startScroll);

                    // 🔥 tab switch handle
                    document.querySelectorAll(".tab-btn").forEach(btn => {
                        btn.addEventListener("click", () => {

                            setTimeout(() => {
                                document.querySelectorAll(".tab-content.active .scroll-container")
                                    .forEach(container => {
                                        startScroll(container);
                                    });
                            }, 200); // wait for tab render
                        });
                    });

                });
            </script>



