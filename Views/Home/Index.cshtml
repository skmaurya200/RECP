<script>
    function sctTab(btn, id) {
        document.querySelectorAll('.sct-tab-btn').forEach(function (b) {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
        });
        document.querySelectorAll('.sct-tab-panel').forEach(function (p) {
            p.classList.remove('active');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        var panel = document.getElementById('sct-' + id);
        if (panel) panel.classList.add('active');
    }
</script>
