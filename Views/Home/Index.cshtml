<script>
    $(document).ready(function () {

        if ($(".event-carousel").length) {
            $(".event-carousel").owlCarousel({
                loop: true,
                margin: 20,
                nav: false,
                dots: false,
                autoplay: true,
                autoplayTimeout: 4000,
                smartSpeed: 600,
                responsive: {
                    0: { items: 1 },
                    576: { items: 1 },
                    768: { items: 2 },
                    992: { items: 3 }
                }
            });
        }

        let evImages = [];
        let evCurrentIndex = 0;

        $(".ev-img").each(function () {
            evImages.push({
                src: $(this).attr("src"),
                title: $(this).attr("alt")
            });
        });

        function evShowImage(index) {
            if (evImages.length === 0) return;

            if (index < 0) index = evImages.length - 1;
            if (index >= evImages.length) index = 0;

            evCurrentIndex = index;

            $("#evmImg").attr("src", evImages[evCurrentIndex].src);
            $("#evmImg").attr("alt", evImages[evCurrentIndex].title);
            $("#evmTitle").text(evImages[evCurrentIndex].title);
        }

        function evOpenModal(index) {
            evShowImage(index);
            $("#evmModal").addClass("evm-show");
            $("body").addClass("evm-body-lock");
        }

        function evCloseModal() {
            $("#evmModal").removeClass("evm-show");
            $("body").removeClass("evm-body-lock");
        }

        $(document).on("click", ".ev-img", function () {
            let index = parseInt($(this).attr("data-index"));
            evOpenModal(index);
        });

        $("#evmClose, .evm-overlay").on("click", function () {
            evCloseModal();
        });

        $("#evmPrev").on("click", function () {
            evShowImage(evCurrentIndex - 1);
        });

        $("#evmNext").on("click", function () {
            evShowImage(evCurrentIndex + 1);
        });

        $(document).on("keydown", function (e) {
            if ($("#evmModal").hasClass("evm-show")) {
                if (e.key === "Escape") evCloseModal();
                if (e.key === "ArrowLeft") evShowImage(evCurrentIndex - 1);
                if (e.key === "ArrowRight") evShowImage(evCurrentIndex + 1);
            }
        });

    });
</script>

