<script defer src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        function getPerView() {
            if (window.innerWidth >= 992) return 4;
            if (window.innerWidth >= 768) return 3;
            if (window.innerWidth >= 576) return 2;
            return 1;
        }

        function loadImage(img) {
            if (!img) return;

            var realSrc = img.getAttribute("data-src");

            if (realSrc) {
                img.setAttribute("src", realSrc);
                img.removeAttribute("data-src");
            }
        }

        function loadNearbyImages(swiper) {
            var perView = getPerView();
            var start = swiper.activeIndex - 1;
            var end = swiper.activeIndex + perView + 2;

            if (start < 0) start = 0;
            if (end > swiper.slides.length) end = swiper.slides.length;

            for (var i = start; i < end; i++) {
                var img = swiper.slides[i].querySelector("img[data-src]");
                loadImage(img);
            }
        }

        var totalSlides = document.querySelectorAll(".homeGallerySwiper .swiper-slide").length;

        if (totalSlides > 0) {
            var homeGallerySwiper = new Swiper(".homeGallerySwiper", {
                slidesPerView: 4,
                spaceBetween: 24,
                speed: 700,

                // loop false rakha hai kyunki loop duplicate slide banata hai
                loop: false,

                // rewind se last ke baad first aur first ke pehle last jaisa behavior milega
                rewind: totalSlides > 4,

                autoplay: totalSlides > 4 ? {
                    delay: 2500,
                    disableOnInteraction: false
                } : false,

                navigation: {
                    nextEl: ".home-gallery-next",
                    prevEl: ".home-gallery-prev"
                },

                breakpoints: {
                    0: {
                        slidesPerView: 1,
                        spaceBetween: 15
                    },
                    576: {
                        slidesPerView: 2,
                        spaceBetween: 18
                    },
                    768: {
                        slidesPerView: 3,
                        spaceBetween: 20
                    },
                    992: {
                        slidesPerView: 4,
                        spaceBetween: 24
                    }
                },

                on: {
                    init: function () {
                        loadNearbyImages(this);
                    },
                    slideChange: function () {
                        loadNearbyImages(this);
                    },
                    resize: function () {
                        loadNearbyImages(this);
                    }
                }
            });
        }
    });
</script>
