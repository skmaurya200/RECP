<script>
document.addEventListener("DOMContentLoaded", function () {

    function startScroll(container) {

        const content = container.querySelector(".scroll-content");

        let speed = 1;
        let pos = container.offsetHeight;

        function animate() {

            // 🔥 IMPORTANT: tab hidden ho to skip
            if (container.offsetHeight === 0) {
                requestAnimationFrame(animate);
                return;
            }

            pos -= speed;

            // 🔥 pure marquee reset (no duplicate)
            if (pos <= -content.scrollHeight) {
                pos = container.offsetHeight;
            }

            content.style.transform = `translateY(${pos}px)`;

            requestAnimationFrame(animate);
        }

        animate();

        // hover pause
        container.addEventListener("mouseenter", () => speed = 0);
        container.addEventListener("mouseleave", () => speed = 1);
    }

    // 🔥 sirf visible tab pe start karo
    document.querySelectorAll(".tab-content.active .scroll-container")
        .forEach(startScroll);

    // 🔥 tab switch handle
    document.querySelectorAll(".tab-btn").forEach(btn => {
        btn.addEventListener("click", () => {

            setTimeout(() => {
                document.querySelectorAll(".tab-content.active .scroll-container")
                    .forEach(container => {
                        startScroll(container);
                    });
            }, 200); // wait for tab render
        });
    });

});
</script>



