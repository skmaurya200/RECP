<script>
document.addEventListener("DOMContentLoaded", function () {
    const box = document.getElementById("marqueeBox");
    const content = document.getElementById("marqueeContent");

    let speed = .5; 
    let pos = box.offsetWidth; // 🔥 start from right side

    // duplicate content
    content.innerHTML += content.innerHTML;

    function animate() {
        pos -= speed;

        // reset when full content scroll ho jaye
        if (Math.abs(pos) >= content.scrollWidth / 2 + box.offsetWidth) {
            pos = box.offsetWidth; // 🔥 again right se start
        }

        content.style.transform = `translateX(${pos}px)`;
        requestAnimationFrame(animate);
    }

    animate();

    // pause on hover
    box.addEventListener("mouseenter", () => speed = 0);
    box.addEventListener("mouseleave", () => speed = 1.5);
});
</script>

