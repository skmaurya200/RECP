    font-size: 24px;
    font-weight: 700;
    line-height: 40px;
    text-align: center;
    z-index: 2;
    transition: all 0.25s ease;
  }

  .custom-modal-close:hover {
    background: rgba(255, 255, 255, 0.28);
    transform: rotate(90deg);
  }

  /* ===== Image ===== */
  .custom-modal-image-wrap {
    width: 100%;
    overflow: hidden;
  }

  .custom-modal-image {
    width: 100%;
    display: block;
    max-height: 80vh;
