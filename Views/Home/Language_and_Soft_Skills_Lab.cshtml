@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Language and Soft Skills Lab
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Language and Soft Skills Lab</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_ASH_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <div class="row">
				<div class="col-sm-7">
				<h5 class="fw-bold mt-4" style="font-size: 18px;">Language and Soft Skills Lab</h5>
				<hr/>
                <p class="welfare-font" style="margin-top:5px;">
                    The language and soft skills laboratory is a modern technology enabled facility designed to enhance students communication abilities and professional competencies. It is equipped with the state-of-the-art All-in-One computers featuring in-built audio-visual tools and microphones, providing an interactive environment for improving pronunciation, fluency, and overall English proficiency. The lab supports activities that strengthen listening, speaking, reading, and writing skills, while fostering teamwork, leadership, critical thinking, and positive body language, preparing students for academic, professional, and interpersonal success.
                </p>

				</div>
				<div class="col-sm-5">
				        <img src="~/Content/DEPIMG/ASH3.jpg" style="border:1px dashed black; padding:5px; margin-top:50px;  height:270px !important; object-fit:cover !important;" />
				</div>
				</div>
                <p class="welfare-font" style="font-size:18px;"><b>Key Activities</b></p>
                <ul class="welfare-font" style="margin-top:-10px; list-style-type:disc !important;">
                    <li>Pronunciation, accent-neutralization, and vocabulary-building sessions</li>
                    <li>Listening modules, spoken English practice, and grammar drills</li>
                    <li>Group discussions, debates, and presentation practices</li>
                    <li>Mock interviews, role-plays, and professional etiquette training</li>
                </ul>

                <p class="welfare-font mt-4">
                    Together, the laboratories of the Applied Sciences and Humanities Department (APSH) create a comprehensive learning environment that reinforces foundational knowledge in applied sciences while enhancing professional communication skills, thereby improving students’ confidence, communication proficiency and employability.
                </p>
                
            </div>
        </div>
    </div>
</div>


















