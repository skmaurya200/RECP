@{
    ViewBag.Title = "Department of Mechanical Engineering";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
        height: 100% !important;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Department of Mechanical Engineering
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Department of Mechanical Engineering</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 19px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
        <!-- LEFT SIDEBAR -->
        <div class="col-lg-3">
            <div class="bg-welfare-left h-100">
                <h3 class="text-uppercase">Side Tabs</h3>
                <hr>
                <ul class="list-unstyled">
                    <li> <i class="fa-solid fa-arrow-up-right-from-square" style="font-size:16px;"></i> <a href="~/home/ASH_Vision"> Vision</a></li>
                    <hr>
                    <li> <i class="fa-solid fa-arrow-up-right-from-square" style="font-size:16px;"></i><a href="~/home/ASH_Mision"> Mission</a> </li>
                    <hr>
                    <li> <i class="fa-solid fa-arrow-up-right-from-square" style="font-size:16px;"></i> <a href="~/home/ASH_Faculty"> Faculty</a></li>
                    <hr>
                    <li> <i class="fa-solid fa-arrow-up-right-from-square" style="font-size:16px;"></i><a href="~/home/ASH_Facilities"> Facilities</a></li>
                    <hr>

                </ul>
            </div>
        </div>

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">
                <h2 class="fw-bold mt-5" style="color:#0747AE; font-size:23px;">Departmental Laboratories</h2>
                <hr>

                <div class="row g-4 mt-2">

                    <!-- Faculty 1 -->
                    
                    <ul class="welfare-font" style="list-style-type:disc !important; margin-left:20px;">
                        <li>Engineering Graphics & Design Lab</li>
                        <li>Workshop Practice Lab</li>
                        <li>Fluid Mechanics Lab</li>
                        <li>Computer-Aided Design (CAD) Lab</li>
                        <li>Material Testing Lab</li>
                        <li>Applied Thermodynamics Lab</li>
                        <li>Manufacturing Processes Lab</li>
                    </ul>

                    <h3 class="mt-4" style="font-weight:800;">Engineering Graphics and Design Lab</h3>
                    <p class="welfare-font" style="margin-top:-10px !important;">
                        The engineering graphics and design Lab forms the foundation of engineering visualization and communication. It bridges conceptual design and practical manufacturing by introducing standards, conventions, and design principles used in mechanical systems. Students learn to represent mechanical components through precise manual drafting. The lab is equipped with modern drawing boards and instruments for learning.
                    </p>

                    <ul class="welfare-font" style="list-style-type:disc !important; margin-left:20px; margin-top:-10px;">
                        <li>Orthographic and isometric projections</li>
                        <li>Sectional drawings</li>
                        <li>Dimensioning and tolerancing</li>
                        <li>Assembly and part drawings</li>
                    </ul>

                    <p class="welfare-font">
                        The engineering graphics and design lab strengthens students spatial understanding, accuracy, and technical communication, supporting advanced design and manufacturing courses.
                    </p>

                    <h3 class="mt-4" style="font-weight:800; margin-top:-10px !important;">Workshop Practice Laboratory</h3>
                    <p class="welfare-font" style="margin-top:-10px;">
                        The workshop practice lab offers students essential hands-on exposure to fundamental manufacturing and fabrication processes. It bridges the gap between theoretical concepts and real-world industrial practices while fostering practical skills, precision, and a strong awareness of safety protocols.
                    </p>

                    <ul class="welfare-font" style="list-style-type:disc !important; margin-left:20px; margin-top:-15px;">
                        <li>Machine Shop</li>
                        <li>Fitting Shop</li>
                        <li>Carpentry Shop</li>
                        <li>Welding Shop</li>
                        <li>Moulding and Casting Shop</li>
                    </ul>

                    <h3 class="mt-4" style="font-weight:800;">Fluid Mechanics Laboratory</h3>
                    <p class="welfare-font" style="margin-top:-10px;">
                        The fluid mechanics laboratory enables students to study the fundamental principles governing fluid behaviour experimentally.
                    </p>

                    <ul class="welfare-font" style="list-style-type:disc !important; margin-left:20px; margin-top:-10px;">
                        <li>Fluid properties and pressure measurement</li>
                        <li>Flow through pipes and losses</li>
                        <li>Bernoulli’s theorem</li>
                        <li>Metacentric height</li>
                        <li>Performance testing of hydraulic machines</li>
                    </ul>

                    <h3 class="mt-4" style="font-weight:800;">Computer-Aided Design (CAD) Laboratory</h3>
                    <p class="welfare-font" style="margin-top:-10px;">
                        The computer-aided design (CAD) laboratory is a core facility that equips students with modern tools and techniques used in engineering design.
                    </p>

                    <h3 class="mt-4" style="font-weight:800;">Material Testing Laboratory</h3>
                    <p class="welfare-font" style="margin-top:-10px;">
                        The material testing laboratory helps students understand the mechanical behaviour of different engineering materials under various loading conditions.
                    </p>

                    <ul class="welfare-font" style="list-style-type:disc !important; margin-left:20px !important; margin-top:-10px;">
                        <li>Universal Testing Machine (UTM)</li>
                        <li>Hardness testers</li>
                        <li>Impact testing equipment</li>
                        <li>Fatigue testing machine</li>
                        <li>Torsion testing machine</li>
                    </ul>

                    <h3 class="mt-4" style="font-weight:800;">Applied Thermodynamics Laboratory</h3>
                    <p class="welfare-font" style="margin-top:-10px;">
                        The applied thermodynamics laboratory enables students to understand the working principles, performance characteristics, and real-world applications of thermal systems.
                    </p>

                    <h3 class="mt-4" style="font-weight:800;">Manufacturing Processes Laboratory</h3>
                    <p class="welfare-font" style="margin-top:-5px;">
                        The manufacturing processes laboratory provides students with practical exposure to fundamental manufacturing techniques used in industry.
                    </p>





                </div>
        </div>
    </div>
</div>
    </div>
