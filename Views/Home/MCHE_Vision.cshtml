@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Vision & Mission
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Vision & Mission</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_MCHE_Sidebar.cshtml")

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Vision</h2>
                <hr />
                <p class="welfare-font" style="margin-top:5px;">
                    To become a centre of excellence in mechanical engineering by integrating core engineering fundamentals with artificial intelligence, digital technologies and sustainable practices, thereby producing competent, innovative and socially responsible engineers to meet the challenges of the global industry.
                </p>

            </div>
			 <div class="content-box mt-2">

                <h2 class="fw-bold" style="color:#0747AE;">Mision</h2>
                <hr />
                <ul class="welfare-font" style="list-style-type:disc;margin-top:10px;">
                    <li>To provide a strong foundation in mechanical engineering principles blended with AI, automation, and modern digital tools.</li>
                    <li>Impart quality education through outcome-based teaching, practical laboratories, industry-oriented projects, and continuous skill development.</li>
                    <li>Promote research, innovation, and entrepreneurship in emerging areas, including smart manufacturing, robotics, renewable energy and intelligent systems.</li>
                    <li>Instil ethical values, professionalism, and social responsibility to enable graduates to contribute positively to industry and society.</li>
                    <li>Strengthen industry-institute interaction through internships, expert lectures, industrial visits and collaborative projects.</li>
                </ul>

            </div>
        </div>
    </div>
</div>





















