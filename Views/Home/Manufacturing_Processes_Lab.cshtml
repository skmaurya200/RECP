			<div class="div2"> <img src="~/Content/DEPIMG/m4.jpg" style="border:1px dashed black; padding:5px; height:270px; width:350px; object-fit:cover;"/></div>
			<div class="div2"> <img src="~/Content/DEPIMG/m5.jpg" style="border:1px dashed black; padding:5px; height:270px; width:350px; object-fit:cover;"/></div>
			
			</div>

            </div>
        </div>
    </div>
</div>



























