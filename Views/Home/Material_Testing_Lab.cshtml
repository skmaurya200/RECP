@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        Material Testing Laboratory
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>Material Testing Laboratory</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
                @Html.Partial("~/Views/Shared/DeptSidebar/_MCHE_Sidebar.cshtml")

        <style>
                    table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 16px;
                        margin-top: 20px;
                    }

                        table th {
                            background-color: #0747AE;
                            color: #fff;
                            font-weight: bold;
                            padding: 10px;
                            border: 1px solid #0747AE;
                        }

                        table td {
                            border: 1px solid #ddd;
                            padding: 10px;
                            text-align: center;
                            background-color: #fafafa;
                        }

                        table tr:hover td {
                            background-color: #f1f5ff;
                        }
        </style>

        <!-- RIGHT CONTENT -->
        <div class="col-lg-9">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">Material Testing Laboratory</h2>
                <hr />
                <p class="welfare-font">
                    The material testing laboratory helps students understand the mechanical behaviour of different engineering materials under various loading conditions. The lab features experiments designed to evaluate various properties, including strength, hardness, toughness, ductility, and elasticity. By performing standardised tests on metals and other materials, students gain practical insight into material selection, failure mechanisms, and quality control practices. This lab plays a crucial role in linking material science fundamentals with design, manufacturing, and structural applications in mechanical engineering. This lab is equipped with the following major testing facilities:
                </p>
                <ul class="welfare-font" style="list-style-type:disc !important; margin-left:20px; margin-top:-10px;">
                    <li>Universal Testing Machine (UTM)</li>
                    <li>Hardness testers</li>
                    <li>Impact testing equipment</li>
                    <li>Fatigue testing machine</li>
                    <li>Torsion testing machine</li>

                </ul>

                <p class="welfare-font">
                    Students analyse properties such as strength, ductility, hardness and toughness, gaining essential knowledge for material selection, structural analysis, and component design.
                </p>
				<div class="div1" style="display:flex;">
				<div class="div2"> <img src="~/Content/DEPIMG/Material Testing Laboratory1.png" style="border:1px dashed black; height:250px; padding:5px;"/></div>
				<div class="div2"> <img src="~/Content/DEPIMG/Material Testing Laboratory2.jpg" style="border:1px dashed black; height:250px; padding:5px;"/></div>
				<div class="div2"> <img src="~/Content/DEPIMG/Material Testing Laboratory3.jpg" style="border:1px dashed black; height:250px; padding:5px;"/></div>
				<div class="div2"> <img src="~/Content/DEPIMG/Material Testing Laboratory4.jpg" style="border:1px dashed black; height:250px; padding:5px;"/></div>
				</div>
            </div>
        </div>
    </div>
</div>



























