
@{
    ViewBag.Title = "Placement_Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row my-5">
    <div class="col-md-12 p-0" style="margin-top: -50px; background: url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') no-repeat center center; background-size: cover; background-attachment:fixed; ">
        <div class="container-fluid" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height: 300px">
                    <h3 class="display-6 text-white text-uppercase fw-bold">Training and Placement</h3>
                    <div class="d-inline-flex text-white">
                        <p class="m-0 text-uppercase"><a class="text-white" href="/" style="text-decoration:none;">Home</a></p>
                        <i class="fa fa-angle-double-right pt-1 px-3"></i>
                        <p class="m-0 text-uppercase text-light">Training and Placement</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row p-5">
        <div class="col-sm-9">
            <h3 style="font-size:22px;" class="fw-bold">Placement Coordinator</h3>
            <hr style="border:1px solid black;" />
            <table class="table table-bordered mt-2">
                <thead>
                    <tr>
                        <th style="background-color:#0747ae;color:white;">Coordinator Name</th>
                        <th style="background-color: #0747ae; color: white; ">Designation</th>
                        <th style="background-color: #0747ae; color: white; ">Email</th>
                        <th style="background-color: #0747ae; color: white; ">Mobile</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>-</td>
                        <td>-</td>
                        <td>-</td>
                        <td>-</td>
                    </tr>
                </tbody>
            </table>

        </div>
        <div class="col-sm-3">
            <div class="p-5" style="height: 40vh; width: 20vw; margin-top: 40px; border-radius: 15px; background-color: #0747ae;">
                <h4 style="font-weight:900; color:white; font-size:19px !important;">Placement Notices</h4>
                <hr />
            </div>
        </div>
    </div>
</div>
</div>

