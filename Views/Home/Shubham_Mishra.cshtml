@{
    ViewBag.Title = "Er. Shubham Mishra";
}

<!-- Banner Section -->
<div class="row my-5">
    <div class="col-md-12 p-0" style="margin-top: -50px; background: url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') no-repeat center center; background-size: cover; background-attachment:fixed;">
        <div class="container-fluid" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height: 300px">
                    <h3 class="display-5 text-white text-uppercase fw-bold">
                         Er. Shubham Mishra
                    </h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Profile Section -->
<div class="container mb-5">
    <div style="display: flex; flex-wrap: wrap; gap: 30px; font-family: Arial; line-height: 1.6; color: #333;">

        <!-- Left Section -->
        <div style="flex: 1; min-width: 280px; max-width: 320px; text-align: center;">
            <img src="~/Content/img/Er.subham.jpg"
                 alt="Er. Shubham Mishra"
                 style="width: 100%; height:400px; object-fit:cover; border-radius: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">

            <h4 style="margin-top: 15px; color: #002147; font-size:19px; font-weight:600; text-align:left;">
                Er. Shubham Mishra
            </h4>

            <p style="margin: 0; color: #555; font-size: 17px; margin-top: -10px; text-align: left;">
                Assistant Professor, Mechanical Engineering
            </p>

            <hr style="border:1px solid black; margin-top:5px;" />

            <div style="margin-top: 10px; font-size: 16px; color: #444; text-align:left;">
                <p class="mt-0 mb-0">
                    <strong>Email:</strong>
                    <a href="mailto:shubham@recp.ac.in" style="text-decoration:underline;color:blue;">
                        shubham@recp.ac.in
                    </a>
                </p>
            </div>
        </div>

        <!-- Right Section -->
        <div style="flex: 2; min-width: 300px;">

            <!-- About -->
            <h4 style="color: #002147; border-bottom: 2px solid #004080; padding-bottom: 5px; font-size:20px; font-weight:600;">
                About Er. Shubham Mishra
            </h4>

            <p style="font-size:16px; font-family:Arial; line-height:30px; text-align:justify; color:black;">
                Er. Shubham Mishra is currently serving as an Assistant Professor in the Mechanical
                Engineering Department at Bharat Ratna Babasaheb Bhimrao Ambedkar Rajkiya Engineering
                College, Pratapgarh, affiliated to Dr. A.P.J. Abdul Kalam Technical University,
                Uttar Pradesh, Lucknow, India.
            </p>

            <p style="font-size:16px; font-family:Arial; line-height:30px; text-align:justify; color:black;">
                Along with his academic duties, he is entrusted with responsibilities as
                In-charge of Horticulture &amp; Housekeeping, Deputy In-charge Controller of Examination,
                and Deputy In-charge Training &amp; Placement at the institute.
            </p>

            <p style="font-size:16px; font-family:Arial; line-height:30px; text-align:justify; color:black;">
                He has completed his B.Tech in Mechanical Engineering from Sri Ram Murti Smarak
                College of Engineering &amp; Technology, Bareilly, and M.Tech in Mechanical Engineering
                from Institute of Engineering &amp; Technology (IET), Lucknow. He is currently pursuing
                a Ph.D. from Dr. A.P.J. Abdul Kalam Technical University, Uttar Pradesh, Lucknow.
            </p>

            <!-- Education -->
            <h4 style="color: #002147; border-bottom: 2px solid #004080; padding-bottom: 5px; margin-top: 30px; font-size: 20px; font-weight: 600;">
                Educational Qualifications
            </h4>

            <ul style="font-size:17px; list-style-type:disc;">
                <li>Ph.D. (Pursuing), Dr. A.P.J. Abdul Kalam Technical University, Lucknow</li>
                <li>M.Tech in Mechanical Engineering, Institute of Engineering &amp; Technology (IET), Lucknow</li>
                <li>B.Tech in Mechanical Engineering, Sri Ram Murti Smarak College of Engineering &amp; Technology (SRMSCET), Bareilly</li>
            </ul>

            <!-- Experience -->
            <h4 style="color: #002147; border-bottom: 2px solid #004080; padding-bottom: 5px; margin-top: 30px; font-size: 20px; font-weight: 600;">
                Experience
            </h4>

            <ul style="font-size:17px; list-style-type:disc;">
                <li>
                    1 Year Experience as Assistant Professor, Mechanical Engineering Department,
                    SIET Prayagraj, Uttar Pradesh.
                </li>
            </ul>

            <!-- Research Interests -->
            <h4 style="color: #002147; border-bottom: 2px solid #004080; padding-bottom: 5px; margin-top: 30px; font-size: 20px; font-weight: 600;">
                Research Interests
            </h4>

            <ul style="font-size:17px; list-style-type:disc;">
                <li>Double-Slope Solar Still</li>
                <li>Thermal Systems</li>
                <li>Phase Change Materials (PCM)</li>
                <li>Electric Vehicles</li>
            </ul>

            <!-- Responsibilities -->
            <h4 style="color: #002147; border-bottom: 2px solid #004080; padding-bottom: 5px; margin-top: 30px; font-size: 20px; font-weight: 600;">
                Responsibilities
            </h4>

            <ul style="font-size:17px; list-style-type:disc;">
                <li>In-charge, Horticulture &amp; Housekeeping, BRBBR Government Engineering College, Pratapgarh</li>
                <li>Deputy In-charge, Controller of Examination, BRBBR Government Engineering College, Pratapgarh</li>
                <li>Deputy In-charge, Training &amp; Placement, BRBBR Government Engineering College, Pratapgarh</li>
            </ul>

        </div>
    </div>
</div>
