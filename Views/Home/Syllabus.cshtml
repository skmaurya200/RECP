<div class="container-fluid" style="background-image:url('/Content/myimg/bg1.jpg');background-attachment:fixed;background-repeat:no-repeat;background-size:cover;">
    <div class="row"><div class="col-sm-12 p-4"><div class="container">
        <h4 class="mt-3 mb-3 fw-bold" style="color:#0747ae;font-size:21px;">Syllabus</h4>
        <hr style="border:1px solid black;" />
        <div class="row table-responsive"><table class="table table-bordered"><thead><tr class="text-center"><th style="background-color:#0747ae;color:white;">S.NO</th><th style="background-color:#0747ae;color:white;">Program</th><th style="background-color:#0747ae;color:white;">Branch</th><th style="background-color:#0747ae;color:white;">Year</th><th style="background-color:#0747ae;color:white;">Read more</th></tr></thead>
            <tbody>@for(var i=0;i<newSyllabus.Count;i++){var item=newSyllabus[i];<tr class="text-center"><td>@(i+1).</td><td>@item.CourseName</td><td>@item.BranchNames</td><td>@item.StudyYear</td><td style="font-weight:900;"><a href="@Url.Content(item.FilePath)" target="_blank" rel="noopener"><i class="fa-solid fa-link" style="color:green;"></i> Link Here</a></td></tr>}@if(!newSyllabus.Any()){<tr class="text-center"><td colspan="5">No new syllabus available.</td></tr>}</tbody>
        </table></div>
    </div></div></div>
</div>
