@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
    }

    .bg-welfare-left {
        background-color: #0747AE;
        padding: 15px;
    }

        .bg-welfare-left h3 {
            font-size: 21px;
            font-weight: 600;
            color: #fff;
        }

        .bg-welfare-left ul li {
            margin-top: 18px;
            font-size: 17px;
            color: #fff;
        }

            .bg-welfare-left ul li a {
                color: #fff;
                text-decoration: none;
            }

                .bg-welfare-left ul li a:hover {
                    text-decoration: underline;
                }

    .content-box {
        border: 1px dashed #000;
        background: #fff;
        padding: 20px;
    }

    .welfare-font {
        font-size: 17px;
        color: #000;
        text-align: justify;
        line-height: 1.8;
    }

    hr {
        border: 1px solid #000;
    }
</style>

<!-- ================= BANNER ================= -->
<div class="row">
    <div class="col-md-12 p-0" style="margin-top:-20px;
        background:url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') center/cover fixed;">
        <div style="background:rgba(0,0,0,0.5)">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height:300px;">
                    <h3 class="display-6 text-white fw-bold">
                        TRAINING AND PLACEMENT CELL
                    </h3>
                    <div class="d-inline-flex text-white">
                        <a href="/" class="text-white text-decoration-none">Home</a>
                        <i class="fa fa-angle-double-right px-2 pt-1"></i>
                        <span>TRAINING AND PLACEMENT CELL</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MAIN CONTENT ================= -->
<div class="container py-5">
    <div class="row">
        <style>
            .bg-welfare-left ul li {
                margin-top: 20px;
                font-size: 17px;
                line-height: 1.5;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .bg-welfare-left hr {
                border-bottom: 2px solid white !important;
            }
        </style>
        <!-- LEFT SIDEBAR -->


        <!-- RIGHT CONTENT -->
        <div class="col-lg-12">
            <div class="content-box">

                <h2 class="fw-bold" style="color:#0747AE;">TRAINING AND PLACEMENT CELL</h2>
                <hr />
                <section class="tp-cell-section welfare-font">
                  

                    <h3 class="welfare-font fw-bold">About</h3>
                    <p class="welfare-font">
                        The Training and Placement Cell (T&amp;P Cell) of
                        Bharat Ratna Babasaheb Bhimrao Ambedkar Rajkiya Engineering College, Pratapgarh,
                        acts as a vital interface between the institute and the industry, facilitating meaningful
                        engagement for student career development, professional training, and employment opportunities.
                    </p>

                    <p class="welfare-font">
                        The cell is committed to bridging the gap between academic learning and industry requirements,
                        ensuring that every graduate is well-prepared to meet professional challenges with competence
                        and confidence.
                    </p>

                    <h3 class="welfare-font fw-bold">Vision</h3>
                    <p class="welfare-font">
                        To empower students with skills and opportunities while serving as a dynamic link between
                        academia and industry for successful career outcomes.
                    </p>

                    <h3 class="welfare-font fw-bold">Mission</h3>
                    <ul class="welfare-font" style="list-style-type:disc !important;">
                        <li>To enhance students’ employability through focused technical and soft-skill training.</li>
                        <li>To facilitate internships, industrial exposure, and campus placement opportunities.</li>
                        <li>To build strong industry linkages for career guidance and recruitment.</li>
                        <li>To prepare students for successful careers, higher studies, and entrepreneurship.</li>
                    </ul>

                    <h3 class="welfare-font fw-bold">Functioning of T&amp;P Cell</h3>
                    <ul class="welfare-font" style="list-style-type:disc !important;">
                        <li>Organize campus recruitment drives and connect students with reputed companies, startups, and PSUs.</li>
                        <li>Conduct training sessions on aptitude, communication, group discussions, and interview techniques.</li>
                        <li>Arrange industrial visits, internships, and expert talks for practical exposure.</li>
                        <li>Maintain a comprehensive student placement database and monitor career progression.</li>
                        <li>Collaborate with industry and alumni networks for mentorship.</li>
                    </ul>

                    <h3 class="welfare-font fw-bold">Facilities &amp; Support</h3>
                    <p class="welfare-font">
                        The T&amp;P Cell is equipped with modern facilities, including
                        Dr. Ambedkar Conference Hall, interview cabins, and digital communication setups.
                    </p>

                    <h3 class="welfare-font fw-bold">Digital Initiatives</h3>
                    <ul class="welfare-font" style="list-style-type:disc !important;">
                        <li>Online placement portal for student registration and job notifications.</li>
                        <li>E-database of student profiles and recruiter dashboards.</li>
                        <li>Virtual pre-placement talks, webinars, and interviews.</li>
                    </ul>

                    <h3 class="welfare-font fw-bold">Our Commitment</h3>
                    <p class="welfare-font">
                        The Training and Placement Cell remains committed to transforming students into
                        industry-ready professionals through strategic collaborations and guidance.
                    </p>

                    <h3 class="welfare-font fw-bold">T&amp;P Cell Administration</h3>
                    <p class="welfare-font">
                        T&amp;P Cell Incharge: Dr. Alok Sanyal, MED<br>
                        T&amp;P Cell Dy-Incharge: Er. Shubham Mishra, MED
                    </p>
                </section>


            </div>
        </div>
    </div>
</div>



















