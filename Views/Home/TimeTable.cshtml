<div class="container-fluid" style="background-image:url('/Content/myimg/bg1.jpg');background-attachment:fixed;background-repeat:no-repeat;background-size:cover;">
    <div class="row">
        <div class="col-sm-12 p-4">
            <div class="container bggws">
                <h1 class="mt-3 mb-3 fw-bold" style="color:#0747ae">TimeTable</h1>
                <hr style="border:1px solid black;" />
                <div class="row table-responsive">
                    <table class="table table-bordered">
                        <thead><tr class="text-center"><th style="background-color:#0747ae;color:white;">S. No.</th><th style="background-color:#0747ae;color:white;">Academic Session</th><th style="background-color:#0747ae;color:white;">Semester</th><th style="background-color:#0747ae;color:white;">Branch</th><th style="background-color:#0747ae;color:white;">Download Link</th></tr></thead>
                        <tbody>@for (var i = 0; i < newTimeTables.Count; i++)
                        {
                            var item = newTimeTables[i];<tr class="text-center"><td>@(i+1)</td><td>@item.SessionName</td><td>@item.SemesterType</td><td>@item.BranchNames</td><td><a href="@Url.Content(item.FilePath)" target="_blank" rel="noopener" style="color:blue;text-decoration:underline;">Click Here</a></td></tr>}@if (!newTimeTables.Any())
                        {<tr class="text-center"><td colspan="5">No new time table available.</td></tr>}</tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
