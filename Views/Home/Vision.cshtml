
@{
    ViewBag.Title = "Vision And Mission";

}

<div class="row">
    <div class="col-md-12 p-0" style="margin-top: -20px; background: url('https://img.freepik.com/premium-photo/extensive-collection-books-library_868797-8212.jpg') no-repeat center center; background-size: cover; background-attachment:fixed; ">
        <div class="container-fluid" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="container">
                <div class="d-flex flex-column justify-content-center" style="min-height: 300px">
                    <h3 class="display-6 text-white text-uppercase fw-bold">Vision and Mission</h3>
                    <div class="d-inline-flex text-white">
                        <p class="m-0 text-uppercase"><a class="text-white" href="/" style="text-decoration:none;">Home</a></p>
                        <i class="fa fa-angle-double-right pt-1 px-3"></i>
                        <p class="m-0 text-uppercase text-light">Vision And Mission</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="our-featues-area inc-trending-courses about-area mt-0" data-aos="fade-up" style="background-image: url(assets/img/bg1.jpg); padding-top: 40px !important;margin-bottom:50px;">

    <style>
        .about-section {
            padding: 30px 0;
        }

        .about-image {
            width: 100%;
            height: 38rem;
            border-radius: 10px;
            box-shadow: 3px 5px 10px rgba(130, 130, 130, 0.5);
        }

        .about-heading {
            font-size: 24px;
            font-weight: 700;
            color: #0747ae;
            border-bottom: 2px solid #D3d3d3;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .about-text {
            font-size: 19px;
            line-height: 1.8;
            color: #000;
            text-align: justify;
            font-family: Arial, sans-serif;
        }

        @@media (max-width: 991.98px) {
            .about-content {
                padding-top: 20px;
            }

            .about-heading {
                font-size: 20px;
            }

            .about-text {
                font-size: 15px;
            }
        }

        @@media (max-width: 575.98px) {
            .about-heading {
                font-size: 18px;
            }

            .about-text {
                font-size: 14px;
            }
        }
    </style>

<div class="container mb-5" style="margin-top:-10px;">
    <div class="row">
        <div class="col-sm-12">
            <h1 class="about-heading">VISION</h1>
            <p class="about-text">
                To become a nationally recognized College of engineering and technological education that fosters innovation, interdisciplinary research, and societal impact. The institute aspires to nurture globally competent engineers equipped with cutting-edge skills in emerging technologies like Artificial Intelligence, Machine Learning, Smart Systems and interdisciplinary engineering while upholding values of integrity, inclusiveness, and service to the nation.
            </p>
            <h1 class="about-heading">MISSION</h1>
            <ol class="about-text">
                <li>
                    Academic Excellence
                    To provide high-quality, future-ready engineering education in CSE, EE, ME, and CE through modern pedagogy, experiential learning, inspired mentorship and continuous curriculum innovation.
                </li>
                <li>
                    Foster Research and Innovation
                    To promote a culture of applied research and innovation with a strong focus on AI, healthcare technologies, sustainable development, and smart infrastructure.
                </li>
                <li>
                    Build Strategic Industry & Academic Linkages
                    To foster academic and industry collaborations that enhance research capabilities, entrepreneurship, and hands-on learning, ensuring graduates are future-ready.

                </li>
                <li>
                    Student-Centric Development
                    To cultivate a dynamic, inclusive, and value-driven learning environment that nurtures creativity, leadership, communication, and ethical responsibility among students.

                </li>
                <li>Societal Impact To actively contribute to regional progress and national missions through technology-driven solutions in agriculture, healthcare, education, and public infrastructure.</li>
            </ol>
        </div>
    </div>
</div>
</div>