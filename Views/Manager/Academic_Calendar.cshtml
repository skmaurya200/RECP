@{ ViewBag.Title="Academic_Calendar"; Layout="~/Views/Shared/ManagerMaster.cshtml"; }
<section class="section-panel active" id="panel-academic" data-list-url="@Url.Action("List","AcademicCalendarApi")" data-save-url="@Url.Action("Save","AcademicCalendarApi")" data-toggle-url="@Url.Action("ToggleStatus","AcademicCalendarApi")" data-delete-url="@Url.Action("Delete","AcademicCalendarApi")">
 @Html.AntiForgeryToken()
 <div class="breadcrumb-row"><div><h4>Academic Calendar</h4><div class="bc-path">Home <i class="bi bi-chevron-right"></i> Academic Calendar</div></div><button class="btn-saffron" id="addCalendarBtn" type="button"><i class="bi bi-plus-lg"></i> Add Calendar</button></div>
 <div class="card-panel"><div class="cph"><h6>All <span>Academic Calendars</span></h6></div><div class="table-responsive"><table class="table table-modern" data-datatable="manual"><thead><tr><th>Sr.No</th><th>Title</th><th>Semester</th><th>File</th><th>Status</th><th>Created By</th><th>Updated By</th><th>Action</th></tr></thead><tbody id="calendarTableBody"><tr><td colspan="8" class="text-center py-4">Loading...</td></tr></tbody></table></div></div>
</section>
