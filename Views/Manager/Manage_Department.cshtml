
@{
    ViewBag.Title = "Manag_Department";
    Layout = "~/Views/Shared/ManagerMaster.cshtml";
}

<!-- ============ MANAGE DEPARTMENT ============ -->
<section class="section-panel active" id="panel-department"
         data-list-url="@Url.Action("List", "DepartmentApi")"
         data-save-url="@Url.Action("Save", "DepartmentApi")"
         data-toggle-url="@Url.Action("ToggleStatus", "DepartmentApi")"
         data-delete-url="@Url.Action("Delete", "DepartmentApi")">
    @Html.AntiForgeryToken()
    <div class="breadcrumb-row">
        <div><h4>Manage Department</h4><div class="bc-path">Home <i class="bi bi-chevron-right"></i> Manage Department</div></div>
        <button class="btn-saffron" type="button" id="addDepartmentBtn"><i class="bi bi-plus-lg"></i> Add Department</button>
    </div>
    <div class="card-panel">
        <div class="cph"><h6>All <span>Departments</span></h6></div>
        <div class="table-responsive">
            <table class="table table-modern" data-datatable="manual">
                <thead><tr><th>Sr.No</th><th>Department Name</th><th>Status</th><th>Action</th></tr></thead>
                <tbody id="departmentTableBody"><tr><td colspan="4" class="text-center text-muted py-4">Loading departments...</td></tr></tbody>
            </table>
        </div>
    </div>
</section>

