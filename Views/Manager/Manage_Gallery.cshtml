@{ ViewBag.Title="Manage_Gallery"; Layout="~/Views/Shared/ManagerMaster.cshtml"; }
<section class="section-panel active" id="panel-gallery"
 data-list-url="@Url.Action("List","ManagerGalleryApi")" data-save-url="@Url.Action("Save","ManagerGalleryApi")" data-toggle-url="@Url.Action("ToggleStatus","ManagerGalleryApi")" data-delete-url="@Url.Action("Delete","ManagerGalleryApi")"
 data-category-list-url="@Url.Action("List","GalleryCategoryApi")" data-category-save-url="@Url.Action("Save","GalleryCategoryApi")">
 @Html.AntiForgeryToken()
 <div class="breadcrumb-row"><div><h4>Manage Gallery</h4><div class="bc-path">Home <i class="bi bi-chevron-right"></i> Manage Gallery</div></div><button class="btn-saffron" id="addGalleryBtn" type="button"><i class="bi bi-plus-lg"></i> Add Gallery</button></div>
 <div class="card-panel"><div class="cph"><h6>All <span>Gallery Images</span></h6></div><div class="table-responsive"><table class="table table-modern" data-datatable="manual"><thead><tr><th>Sr.No</th><th>Image</th><th>Category</th><th>Title</th><th>Status</th><th>Created By</th><th>Updated By</th><th>Action</th></tr></thead><tbody id="galleryTableBody"><tr><td colspan="8" class="text-center py-4">Loading...</td></tr></tbody></table></div></div>
</section>
