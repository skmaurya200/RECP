 <div class="card-panel"><div class="cph"><h6>All <span>Press Releases</span></h6></div><div class="table-responsive"><table class="table table-modern" data-datatable="manual"><thead><tr><th>Sr.No</th><th>Image</th><th>Title</th><th>Status</th><th>Created By</th><th>Updated By</th><th>Action</th></tr></thead><tbody id="pressTableBody"><tr><td colspan="7" class="text-center py-4">Loading...</td></tr></tbody></table></div></div>
