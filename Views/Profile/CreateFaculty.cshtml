@model Rec_Partapgarh.Models.profile
@{
    ViewBag.Title = "Add New Faculty";
    Layout = "~/Views/Shared/admin.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header  text-white d-flex justify-content-between align-items-center" style="background-color: #2A1C5A;">
            <h4 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i> Add New Faculty</h4>
            <a href="@Url.Action("Faculties", "Profile")" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left-circle me-1"></i> Back
            </a>
        </div>

        <div class="card-body p-4">
            @using (Html.BeginForm("CreateFaculty", "Profile", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.FullName, "Full Name", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Enter full name", required = "required" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Designation, "Designation", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Designation, new { @class = "form-control", placeholder = "e.g. Assistant Professor" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "Enter email address" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Mobile, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control", placeholder = "Enter mobile number" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Upload Image</label>
                        <div class="input-group">
                            <input type="file" name="imageFile" class="form-control" accept="image/*" required />
                            <span class="input-group-text"><i class="bi bi-upload"></i></span>
                        </div>
                        <small class="text-muted">Allowed formats: JPG, PNG (Max 2MB)</small>
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ProfileUrl, "Profile URL (optional)", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ProfileUrl, new { @class = "form-control", placeholder = "Enter profile link" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.SortOrder, "Display Order", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control", type = "number", placeholder = "Enter order number" })
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check mt-3">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "isActiveCheck" })
                            <label for="isActiveCheck" class="form-check-label fw-bold">Active Faculty</label>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-bold">Complete Profile Content</label>
                        @Html.TextAreaFor(m => m.CompleteProfileHtml, new { @class = "form-control", id = "editor", rows = "8" })
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save2 me-1"></i> Save Faculty
                    </button>
                    <a href="@Url.Action("Faculties", "Profile")" class="btn btn-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- ✅ CKEditor -->
<script src="https://cdn.ckeditor.com/4.21.0/standard/ckeditor.js"></script>
<script>
    CKEDITOR.replace('editor', {
        height: 250,
        removeButtons: 'PasteFromWord'
    });
</script>

<!-- ✅ Bootstrap Icons (if not already included) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
