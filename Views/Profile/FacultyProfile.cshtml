
@{
    ViewBag.Title = "FacultyProfile";
    Layout = "~/Views/Shared/admin.cshtml";
}

@model Rec_Partapgarh.Models.profile

<div class="container my-5">
    <div class="row">
        <!-- Left Section -->
        <div class="col-md-4 text-center mb-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.FullName" class="img-fluid rounded shadow-sm" />
            }
            else
            {
                <div class="bg-secondary text-white p-5 rounded">No Image</div>
            }

            <h4 class="mt-3">@Model.FullName</h4>
            <p class="text-muted">@Model.Designation</p>
            <p>
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <strong>Email:</strong> <a href="mailto:@Model.Email">@Model.Email</a><br />
                }
                @if (!string.IsNullOrEmpty(Model.Mobile))
                {
                    <strong>Mobile:</strong> @Model.Mobile
                }
            </p>
        </div>

        <!-- Right Section -->
        <div class="col-md-8">
            @* Complete Profile HTML from admin *@
            @Html.Raw(Model.CompleteProfileHtml)
        </div>
    </div>

    <div class="mt-4">
        <a href="@Url.Action("Faculties", "Profile")" class="btn btn-secondary">Back to Faculty List</a>
    </div>
</div>

