                    <input type="hidden" id="syllabusId" value="0"><div class="mb-3"><label class="form-label">Programme</label><input class="form-control" id="syllabusCourse" maxlength="150" placeholder="e.g. Bachelor of Technology"><div class="invalid-feedback" data-val-for="SyllabusCourse"></div></div>
                    <div class="mb-3"><label class="form-label">Branch</label><input class="form-control" id="syllabusBranch" maxlength="500" placeholder="e.g. CSE, EE, CE, ME"><small class="text-muted">Multiple branches comma separated enter karein.</small><div class="invalid-feedback" data-val-for="SyllabusBranch"></div></div>
                    <div class="mb-3"><label class="form-label">Year</label><select class="form-select" id="syllabusYear"><option value="">Select year</option><option>First Year</option><option>Second Year</option><option>Third Year</option><option>Fourth Year</option></select><div class="invalid-feedback" data-val-for="SyllabusYear"></div></div>
                    <div class="mb-3"><label class="form-label">File</label><div class="upload-box manager-drop-zone" id="syllabusDropZone" tabindex="0"><input type="file" id="syllabusFile" accept=".pdf,.doc,.docx" hidden><i class="bi bi-file-earmark-arrow-up"></i><p id="syllabusFilePrompt">Click or drag PDF/Word file<br><small>Maximum 3 MB; optional while editing</small></p></div><div class="invalid-feedback d-block" data-val-for="SyllabusFile"></div></div>
                </div>
                <div class="modal-footer"><button class="btn-outline-soft" data-bs-dismiss="modal">Cancel</button><button class="btn-saffron" id="saveSyllabusBtn">Save Syllabus</button></div>
            </div>
        </div>
    </div>

    <!-- Staff Modal -->
    <div class="modal fade" id="modalStaff" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title" id="staffModalTitle">Add Teaching Staff</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <input type="hidden" id="staffId" value="0"><div class="mb-3"><label class="form-label">Photo</label><div class="upload-box manager-drop-zone" id="staffPhotoDropZone" tabindex="0"><input type="file" id="staffPhoto" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" hidden><img id="staffPhotoPreview" class="staff-photo-preview d-none" alt="Staff photo"><div id="staffPhotoPrompt"><i class="bi bi-person-bounding-box"></i><p>Click or drag photo<br><small>JPG, PNG or WEBP; maximum 3 MB</small></p></div></div><div class="invalid-feedback d-block" data-val-for="StaffPhoto"></div></div>
                    <div class="row"><div class="col-md-6 mb-3"><label class="form-label">Name</label><input class="form-control" id="staffName" maxlength="150"><div class="invalid-feedback" data-val-for="StaffName"></div></div><div class="col-md-6 mb-3"><label class="form-label">Email</label><input class="form-control" id="staffEmail" type="email" maxlength="254"><div class="invalid-feedback" data-val-for="StaffEmail"></div></div></div>
                    <div class="row"><div class="col-md-4 mb-3"><label class="form-label">ALT Email <small class="text-muted">(Optional)</small></label><input class="form-control" id="staffAlternateEmail" type="email" maxlength="254" placeholder="alternate@example.com"><div class="invalid-feedback" data-val-for="StaffAlternateEmail"></div></div><div class="col-md-4 mb-3"><label class="form-label">Mobile No. <small class="text-muted">(Optional)</small></label><input class="form-control" id="staffMobileNumber" type="tel" maxlength="20" placeholder="e.g. +91 9876543210"><div class="invalid-feedback" data-val-for="StaffMobileNumber"></div></div><div class="col-md-4 mb-3"><label class="form-label">Landline No. <small class="text-muted">(Optional)</small></label><input class="form-control" id="staffLandlineNumber" type="tel" maxlength="25" placeholder="e.g. 05342-123456"><div class="invalid-feedback" data-val-for="StaffLandlineNumber"></div></div></div>
                    <div class="row"><div class="col-md-6 mb-3"><label class="form-label">Designation</label><input class="form-control" id="staffDesignation" maxlength="150"><div class="invalid-feedback" data-val-for="StaffDesignation"></div></div><div class="col-md-6 mb-3"><label class="form-label">Department</label><select class="form-select" id="staffDepartment"><option value="">Loading departments...</option></select><div class="invalid-feedback" data-val-for="StaffDepartment"></div></div></div>
                    <div class="row"><div class="col-md-8 mb-3"><label class="form-label">Qualification</label><input class="form-control" id="staffQualification" maxlength="250"><div class="invalid-feedback" data-val-for="StaffQualification"></div></div><div class="col-md-4 mb-3"><label class="form-label">Display Order <small class="text-muted">(Optional)</small></label><input class="form-control" id="staffDisplayOrder" type="number" min="1" max="9999" step="1" placeholder="e.g. 1"><div class="invalid-feedback" data-val-for="StaffDisplayOrder"></div><small class="text-muted">Ordered staff appear first.</small></div></div>
                    <div class="mb-3"><label class="form-label">Long Description <small class="text-muted">(Optional)</small></label><textarea id="staffDescription"></textarea>    <small class="text-muted d-block mt-2">
        Note: For consistency with the website theme, use 18px font size for paragraphs and 20px font size for headings. 
        Set the heading color to #002147, apply a bottom border below headings, and use 1.90 line-height for paragraph content.
    </small><div class="invalid-feedback d-block" data-val-for="StaffDescription"></div></div>
                    <div class="mb-1"><label class="form-label">Status</label><select class="form-select" id="staffStatus"><option value="true">Active</option><option value="false">Inactive</option></select></div>
                </div>
                <div class="modal-footer"><button class="btn-outline-soft" data-bs-dismiss="modal">Cancel</button><button class="btn-saffron" id="saveStaffBtn">Save Staff</button></div>
            </div>
        </div>
    </div>

    <div class="modal fade staff-description-modal" id="modalStaffDescription" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title" id="staffDescriptionModalTitle">Staff Long Description</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body staff-description-modal-body p-0"><iframe id="staffDescriptionFrame" class="staff-description-frame" sandbox title="Staff long description"></iframe></div>
                <div class="modal-footer"><button class="btn-outline-soft" data-bs-dismiss="modal">Close</button></div>
            </div>
        </div>
    </div>

    <!-- Press Modal -->
    <div class="modal fade" id="modalPress" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title" id="pressModalTitle">Add Press Release</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <input type="hidden" id="pressId" value="0"><div class="mb-3"><label class="form-label">Title</label><input class="form-control" id="pressTitle" maxlength="200"><div class="invalid-feedback" data-val-for="PressTitle"></div></div>
                    <div class="mb-3"><label class="form-label">Image</label><div class="upload-box manager-drop-zone" id="pressDropZone" tabindex="0"><input type="file" id="pressImage" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" hidden><img id="pressImagePreview" class="slider-image-preview d-none" alt="Press release preview"><div id="pressUploadPrompt"><i class="bi bi-cloud-arrow-up"></i><p>Click or drag image<br><small>JPG, PNG or WEBP; maximum 3 MB</small></p></div></div><div class="invalid-feedback d-block" data-val-for="PressImage"></div></div>
                    <div class="mb-1"><label class="form-label">Status</label><select class="form-select" id="pressStatus"><option value="true">Active</option><option value="false">Inactive</option></select></div>
                </div>
                <div class="modal-footer"><button class="btn-outline-soft" data-bs-dismiss="modal">Cancel</button><button class="btn-saffron" id="savePressBtn">Save Press Release</button></div>
            </div>
        </div>
    </div>

    <!-- Academic Calendar Modal -->
    <div class="modal fade" id="modalCalendar" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title" id="calendarModalTitle">Add Academic Calendar</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <input type="hidden" id="calendarId" value="0"><div class="mb-3"><label class="form-label">Title</label><input class="form-control" id="calendarTitle" maxlength="200"><div class="invalid-feedback" data-val-for="CalendarTitle"></div></div>
                    <div class="mb-3"><label class="form-label">Semester</label><select class="form-select" id="calendarSemester"><option value="">Select semester</option><option>Odd Semester</option><option>Even Semester</option></select><div class="invalid-feedback" data-val-for="CalendarSemester"></div></div>
                    <div class="mb-3"><label class="form-label">File</label><div class="upload-box manager-drop-zone" id="calendarDropZone" tabindex="0"><input type="file" id="calendarFile" accept=".pdf,.docx" hidden><i class="bi bi-file-earmark-arrow-up"></i><p id="calendarFilePrompt">Click or drag PDF/DOCX file<br><small>Maximum 3 MB; optional while editing</small></p></div><div class="invalid-feedback d-block" data-val-for="CalendarFile"></div></div>
                    <div class="mb-1"><label class="form-label">Status</label><select class="form-select" id="calendarStatus"><option value="true">Active</option><option value="false">Inactive</option></select></div>
                </div>
                <div class="modal-footer"><button class="btn-outline-soft" data-bs-dismiss="modal">Cancel</button><button class="btn-saffron" id="saveCalendarBtn">Save Calendar</button></div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.ckeditor.com/4.22.1/full-all/ckeditor.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/v/bs5/dt-2.3.8/b-3.2.6/b-colvis-3.2.6/b-html5-3.2.6/b-print-3.2.6/datatables.min.js"></script>
    <script>
        window.showManagerAlert = function (icon, message) {
            return Swal.fire({
                toast: true,
                position: 'top-end',
                icon: icon || 'success',
                title: message,
                showConfirmButton: false,
                timer: 2500,
                timerProgressBar: true
            });
        };

        window.clearManagerValidation = function (container) {
            if (!container) return;
            container.querySelectorAll('.is-invalid').forEach(function (field) { field.classList.remove('is-invalid'); });
            container.querySelectorAll('[data-val-for]').forEach(function (error) { error.textContent = ''; });
        };

        window.showManagerValidation = function (container, errors) {
            window.clearManagerValidation(container);
            Object.keys(errors || {}).forEach(function (key) {
                var error = container.querySelector('[data-val-for="' + key + '"]');
                if (error) error.textContent = errors[key];
                var fieldMap = { DepartmentName: 'departmentName', Title: 'sliderTitle', SortDescription: 'sliderDescription', ImageFile: 'sliderImage', NoticeType: 'noticeType', NoticeTitle: 'noticeTitle', NoticeFile: 'noticeFile', EventName: 'eventName', Venue: 'eventVenue', EventDate: 'eventDate', EventTime: 'eventTime', BannerImage: 'eventBannerImage', VideoTitle: 'videoTitle', SourceUrl: 'videoSource', GalleryCategory: 'galleryCategory', GalleryTitle: 'galleryTitle', GalleryImage: 'galleryImage', CategoryName: 'galleryCategoryName', TimeTableSession: 'timeTableSession', TimeTableCourse: 'timeTableCourse', TimeTableSemester: 'timeTableSemester', TimeTableYear: 'timeTableYear', TimeTableBranch: 'timeTableBranch', TimeTableFile: 'timeTableFile', SyllabusSession: 'syllabusSession', SyllabusCourse: 'syllabusCourse', SyllabusYear: 'syllabusYear', SyllabusSemester: 'syllabusSemester', SyllabusBranch: 'syllabusBranch', SyllabusFile: 'syllabusFile', StaffPhoto: 'staffPhoto', StaffName: 'staffName', StaffEmail: 'staffEmail', StaffDesignation: 'staffDesignation', StaffDepartment: 'staffDepartment', StaffQualification: 'staffQualification', PressTitle: 'pressTitle', PressImage: 'pressImage', CalendarTitle: 'calendarTitle', CalendarSemester: 'calendarSemester', CalendarFile: 'calendarFile', UserUsername: 'managerUserUsername', UserDisplayName: 'managerUserDisplayName', UserPassword: 'managerUserPassword', UserConfirmPassword: 'managerUserConfirmPassword', CurrentPassword: 'currentManagerPassword', NewPassword: 'newManagerPassword', ConfirmPassword: 'confirmManagerPassword' };
                var staffFieldMap = { StaffDisplayOrder: 'staffDisplayOrder', StaffAlternateEmail: 'staffAlternateEmail', StaffMobileNumber: 'staffMobileNumber', StaffLandlineNumber: 'staffLandlineNumber' };
                var field = document.getElementById(staffFieldMap[key] || fieldMap[key]);
                if (field && field.type !== 'file') field.classList.add('is-invalid');
            });
        };

        window.initManagerDataTable = function (table) {
            if (!table || !window.jQuery || !$.fn.DataTable || $.fn.DataTable.isDataTable(table)) return;

            var exportColumns = function (columnIndex, data, node) {
                var heading = table.querySelectorAll('thead th')[columnIndex];
                return heading && heading.textContent.trim().toLowerCase() !== 'action';
            };
            var smallButtonClass = 'btn btn-sm manager-dt-btn rounded-0';

            $(table).DataTable({
                layout: {
                    topStart: {
                        buttons: [
                            { extend: 'copyHtml5', className: smallButtonClass, text: '<i class="bi bi-clipboard"></i> Copy', exportOptions: { columns: exportColumns } },
                            { extend: 'csvHtml5', className: smallButtonClass, text: '<i class="bi bi-filetype-csv"></i> CSV', exportOptions: { columns: exportColumns } },
                            { extend: 'excelHtml5', className: smallButtonClass, text: '<i class="bi bi-file-earmark-excel"></i> Excel', exportOptions: { columns: exportColumns } },
                            { extend: 'pdfHtml5', className: smallButtonClass, text: '<i class="bi bi-file-earmark-pdf"></i> PDF', orientation: 'landscape', pageSize: 'A4', exportOptions: { columns: exportColumns } },
                            { extend: 'print', className: smallButtonClass, text: '<i class="bi bi-printer"></i> Print', exportOptions: { columns: exportColumns } },
                            { extend: 'colvis', className: smallButtonClass, text: '<i class="bi bi-layout-three-columns"></i> Columns' },
                            { extend: 'pageLength', className: smallButtonClass, text: '<i class="bi bi-list-ol"></i> Rows' }
                        ]
                    },
                    topEnd: 'search',
                    bottomStart: 'info',
                    bottomEnd: 'paging'
                },
                pageLength: 10,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, 'All']],
                order: [],
                autoWidth: false,
                scrollX: true,
                language: {
                    search: '',
                    searchPlaceholder: 'Search records...',
                    emptyTable: 'No records found'
                }
            });
        };
    </script>
    <script src="~/Content/manager/script.js"></script>
    <script>
        document.querySelectorAll('table.table-modern:not([data-datatable="manual"])').forEach(window.initManagerDataTable);
    </script>
</body>
</html>
