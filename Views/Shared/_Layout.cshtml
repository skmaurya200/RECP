        <script>
            (function () {
                var navbar = document.getElementById('navbarSupportedContent');
                if (!navbar) return;

                function directChild(parent, className) {
                    for (var i = 0; i < parent.children.length; i++) {
                        if (parent.children[i].classList.contains(className)) return parent.children[i];
                    }
                    return null;
                }

                function closeMenus(exceptItem) {
                    navbar.querySelectorAll('.navbar-nav > .nav-item.dropdown').forEach(function (item) {
                        if (item === exceptItem) return;
                        var toggle = directChild(item, 'dropdown-toggle');
                        var menu = directChild(item, 'dropdown-menu');
                        item.classList.remove('show');
                        if (menu) {
                            menu.classList.remove('show');
                            menu.querySelectorAll('.dropdown-menu.show').forEach(function (submenu) {
                                submenu.classList.remove('show');
                            });
                        }
                        if (toggle) toggle.setAttribute('aria-expanded', 'false');
                    });
                }

                document.addEventListener('click', function (event) {
                    var toggle = event.target.closest ? event.target.closest('.dropdown-toggle') : null;

                    if (toggle && navbar.contains(toggle)) {
                        var item = toggle.parentElement;
                        var menu = directChild(item, 'dropdown-menu');

                        if (item.classList.contains('nav-item') && item.classList.contains('dropdown') && item.parentElement.classList.contains('navbar-nav')) {
                            event.preventDefault();
                            event.stopImmediatePropagation();
                            var willOpen = !menu.classList.contains('show');
                            closeMenus(item);
                            item.classList.toggle('show', willOpen);
                            menu.classList.toggle('show', willOpen);
                            toggle.setAttribute('aria-expanded', String(willOpen));
                            return;
                        }

                        if (item.classList.contains('dropdown-submenu') && menu) {
                            event.preventDefault();
                            event.stopImmediatePropagation();
                            var willOpenSubmenu = !menu.classList.contains('show');
                            item.parentElement.querySelectorAll('.dropdown-submenu > .dropdown-menu.show').forEach(function (submenu) {
                                submenu.classList.remove('show');
                            });
                            menu.classList.toggle('show', willOpenSubmenu);
                            toggle.setAttribute('aria-expanded', String(willOpenSubmenu));
                            return;
                        }
                    }

                    if (!event.target.closest || !event.target.closest('#navbarSupportedContent .dropdown-menu')) closeMenus();
                }, true);

                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') closeMenus();
                }, true);

                navbar.querySelectorAll('a.nav-link:not(.dropdown-toggle), .dropdown-menu a.dropdown-item').forEach(function (link) {
                    link.addEventListener('click', function () {
                        if (!window.matchMedia('(max-width: 1199.98px)').matches) return;

                        closeMenus();
                        var toggler = document.querySelector('[data-bs-target="#navbarSupportedContent"]');
                        if (window.bootstrap && window.bootstrap.Collapse) {
                            window.bootstrap.Collapse.getOrCreateInstance(navbar, { toggle: false }).hide();
                        } else {
                            navbar.classList.remove('show');
                        }
                        if (toggler) toggler.setAttribute('aria-expanded', 'false');
                    });
                });
            }());
        </script>





