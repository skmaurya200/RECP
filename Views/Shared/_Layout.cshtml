    <script>
        function formatDateTime() {
            const now = new Date();
            const options = {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: 'numeric',
                minute: '2-digit',
                second: '2-digit',
                hour12: true
            };
            return now.toLocaleString('en-US', options);
        }

        function updateTime() {
            const timeElement = document.getElementById('time');
            if (timeElement) timeElement.innerText = formatDateTime();
        }

