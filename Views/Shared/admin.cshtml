                        <script>
                            // Add this script to handle the expansion panel toggle behavior.
                            document.querySelectorAll('.mdc-expansion-panel-link').forEach(link => {
                                link.addEventListener('click', function (event) {
                                    event.preventDefault();

                                    // Get target panel ID from the data-target attribute
                                    const targetPanelId = link.getAttribute('data-target');
                                    const targetPanel = document.getElementById(targetPanelId);

                                    // If the panel is already open, close it
                                    if (targetPanel.classList.contains('mdc-expansion-panel--opened')) {
                                        targetPanel.classList.remove('mdc-expansion-panel--opened');
                                    } else {
                                        // Close all other panels first
                                        document.querySelectorAll('.mdc-expansion-panel').forEach(panel => {
                                            panel.classList.remove('mdc-expansion-panel--opened');
                                        });
                                        // Open the selected panel
                                        targetPanel.classList.add('mdc-expansion-panel--opened');
                                    }
                                });
                            });

                        </script>
